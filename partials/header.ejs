<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Event Hub — Discover Exciting Events in Your City</title>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Icon Fonts: Bootstrap Icons & FontAwesome -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#3368A0',
            secondary: '#66A3BF',
            accent: '#C8DFDB',
            'bg-base': '#F2EFE7',
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    /* Custom scrollbar styling for filter pills */
    .scrollbar-none::-webkit-scrollbar {
      display: none;
    }

    .scrollbar-none {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>

<body class="bg-bg-base text-gray-900 font-sans antialiased min-h-screen flex flex-col">

  <!-- ==================== HEADER (Full in home.ejs) ==================== -->
  <header class="bg-white border-b border-gray-200/80 sticky top-0 z-50 shadow-sm">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl h-16 flex items-center justify-between">
      <!-- Brand Logo & Title -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-9 h-9 rounded-xl bg-primary text-white flex items-center justify-center font-black text-lg shadow-md shadow-primary/20 group-hover:scale-105 transition-transform">
          E
        </div>
        <span class="text-xl font-extrabold text-gray-900 tracking-tight">Event<span class="text-primary">Hub</span></span>
      </a>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-semibold">
        <a href="/" class="text-primary border-b-2 border-primary pb-1 transition-colors">Home</a>
        <a href="#" class="text-gray-600 hover:text-primary transition-colors">Events</a>

        <!-- User Dropdown Placeholder -->
        <div class="relative group">
          <button class="flex items-center gap-2 text-gray-700 hover:text-primary transition-colors focus:outline-none">
            <div class="w-8 h-8 rounded-full bg-accent/80 flex items-center justify-center text-primary font-bold border border-accent">
              U
            </div>
            <span>User</span>
            <svg class="w-4 h-4 text-gray-400 group-hover:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
        </div>
      </nav>
    </div>
  </header>
  <!-- ==================== END HEADER ==================== -->