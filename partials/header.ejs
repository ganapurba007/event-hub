<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Event Hub — Discover Exciting Events in Your City</title>

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- jQuery & Select2 CSS / JS Dependencies -->
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

  <!-- Icon Fonts: Bootstrap Icons & FontAwesome -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: '#3368A0',
            secondary: '#66A3BF',
            accent: '#C8DFDB',
            'bg-base': '#F2EFE7',
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
  <style>
    /* Custom scrollbar styling for filter pills */
    .scrollbar-none::-webkit-scrollbar {
      display: none;
    }

    .scrollbar-none {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }


    /* Custom Select2 Styling for Tailwind & App Design System */
    .select2-container--default .select2-selection--single {
      background-color: rgba(242, 239, 231, 0.5) !important;
      /* bg-bg-base/50 */
      border: 1px solid #e5e7eb !important;
      /* border-gray-200 */
      border-radius: 1rem !important;
      /* rounded-2xl */
      height: 3.25rem !important;
      /* py-3.5 match height */
      display: flex !important;
      align-items: center !important;
      padding-left: 2.5rem !important;
      /* Icon spacing */
      transition: all 0.2s ease-in-out !important;
    }

    .select2-container--default .select2-selection--single:focus,
    .select2-container--default.select2-container--open .select2-selection--single {
      border-color: #3368A0 !important;
      /* primary color */
      background-color: #ffffff !important;
      box-shadow: 0 0 0 2px rgba(51, 104, 160, 0.2) !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
      color: #1f2937 !important;
      /* text-gray-800 */
      font-weight: 500 !important;
      font-size: 1rem !important;
      padding-left: 0 !important;
      line-height: normal !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
      height: 100% !important;
      right: 0.75rem !important;
    }

    .select2-dropdown {
      border-radius: 1rem !important;
      border: 1px solid #f3f4f6 !important;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
      overflow: hidden !important;
      z-index: 9999 !important;
      padding: 0.25rem !important;
    }

    .select2-results__option {
      border-radius: 0.5rem !important;
      padding: 0.5rem 0.75rem !important;
      font-size: 0.875rem !important;
      font-weight: 500 !important;
    }

    .select2-results__option--highlighted[aria-selected] {
      background-color: #3368A0 !important;
      color: white !important;
    }

    .select2-search__field {
      border-radius: 0.75rem !important;
      border: 1px solid #e5e7eb !important;
      padding: 0.5rem 0.75rem !important;
      outline: none !important;
    }

    .select2-search__field:focus {
      border-color: #3368A0 !important;
    }
  </style>
</head>

<body class="bg-bg-base text-gray-900 font-sans antialiased min-h-screen flex flex-col">

  <!-- ==================== HEADER ==================== -->
  <header class="bg-white border-b border-gray-200/80 sticky top-0 z-50 shadow-sm">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl h-16 flex items-center justify-between">

      <!-- Brand Logo & Title -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-10 h-10 rounded-2xl bg-primary text-white flex items-center justify-center font-black text-xl shadow-md shadow-primary/25 group-hover:scale-105 transition-transform duration-200">
          E
        </div>
        <span class="text-xl font-extrabold text-gray-900 tracking-tight">Event<span class="text-primary">Hub</span></span>
      </a>

      <!-- Navigation Links & User Controls -->
      <nav class="flex items-center gap-6 text-sm font-semibold" id="main-nav">
        <!-- Main Nav Links with Auto Active Classing -->
        <a href="/" class="nav-link text-gray-600 hover:text-primary pb-1 transition-colors" data-path="/">Home</a>
        <a href="/events" class="nav-link text-gray-600 hover:text-primary pb-1 transition-colors" data-path="/events">Events</a>

        <% if (typeof user !== 'undefined' && user && user.role === 'creator') { %>
        <a href="/my-events" class="nav-link text-gray-600 hover:text-primary pb-1 transition-colors hidden sm:inline-block" data-path="/my-events">My Events</a>
        <a href="/events/create" class="bg-accent/60 hover:bg-accent text-primary px-4 py-2 rounded-xl transition-all font-semibold flex items-center gap-1.5 border border-primary/20">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          <span>Create Event</span>
        </a>
        <% } %>

        <% if (typeof user !== 'undefined' && user) { %>
        <!-- User Dropdown Menu (Logged In) -->
        <div class="relative group">
          <button type="button" class="flex items-center gap-2.5 text-gray-700 hover:text-primary transition-colors focus:outline-none py-1.5 px-2 rounded-xl hover:bg-bg-base/60">
            <div class="w-8 h-8 rounded-full bg-primary/10 text-primary font-bold border border-primary/20 flex items-center justify-center text-sm shadow-sm">
              <%= (user.name) ? user.name.charAt(0).toUpperCase() : 'U' %>
            </div>
            <span class="font-semibold text-gray-800 hidden sm:inline-block">
              <%= user.name || 'User' %>
            </span>
            <svg class="w-4 h-4 text-gray-400 group-hover:text-primary transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Options -->
          <div class="absolute right-0 mt-2 w-56 bg-white rounded-2xl shadow-xl border border-gray-100 py-2 hidden group-hover:block transition-all duration-200 z-50">
            <div class="px-4 py-2.5 border-b border-gray-100 bg-bg-base/30 rounded-t-2xl">
              <p class="text-[11px] text-gray-400 font-bold uppercase tracking-wider">Signed in as</p>
              <p class="text-sm font-bold text-gray-800 truncate"><%= user.name || 'User' %></p>
              <% if (user.role) { %>
              <span class="inline-block mt-1 text-[10px] font-extrabold uppercase px-2 py-0.5 bg-accent/60 text-primary rounded-full border border-primary/20">
                <%= user.role %>
              </span>
              <% } %>
            </div>

            <!-- Profile -->
            <a href="/profile" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-bg-base hover:text-primary transition-colors">
              <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <span>Profile</span>
            </a>

            <!-- My Orders -->
            <a href="/my-orders" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-bg-base hover:text-primary transition-colors">
              <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>My Orders</span>
            </a>

            <!-- My Events (If Creator) -->
            <% if (user.role === 'creator') { %>
            <a href="/my-events" class="flex items-center gap-3 px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-bg-base hover:text-primary transition-colors">
              <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <span>My Events</span>
            </a>
            <% } %>

            <div class="border-t border-gray-100 my-1"></div>

            <!-- Logout -->
            <a href="/logout" class="flex items-center gap-3 px-4 py-2.5 text-sm font-semibold text-red-600 hover:bg-red-50 transition-colors rounded-b-2xl">
              <svg class="w-4 h-4 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              <span>Logout</span>
            </a>
          </div>
        </div>

        <% } else { %>
        <!-- Guest Controls (Logged Out) -->
        <div class="flex items-center gap-3">
          <a href="/login" class="text-gray-700 hover:text-primary font-semibold px-3 py-2 transition-colors">
            Login
          </a>
          <a href="/register" class="bg-primary hover:bg-secondary text-white px-5 py-2 rounded-xl font-semibold transition-all shadow-md shadow-primary/20 hover:scale-105">
            Register
          </a>
        </div>
        <% } %>
      </nav>

    </div>
  </header>
  <!-- ==================== END HEADER ==================== -->

  <!-- Script for Auto Active Navigation Link Highlighting -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const currentPath = window.location.pathname;
      const navLinks = document.querySelectorAll('#main-nav .nav-link');

      navLinks.forEach(link => {
        const linkPath = link.getAttribute('data-path') || link.getAttribute('href');
        let isActive = false;

        if (linkPath === '/') {
          isActive = currentPath === '/';
        } else if (linkPath) {
          isActive = currentPath === linkPath || (linkPath !== '/' && currentPath.startsWith(linkPath));
        }

        if (isActive) {
          link.classList.remove('text-gray-600');
          link.classList.add('text-primary', 'border-b-2', 'border-primary', 'font-bold');
        } else {
          link.classList.remove('text-primary', 'border-b-2', 'border-primary', 'font-bold');
          link.classList.add('text-gray-600');
        }
      });
    });
  </script>