  <!-- Client-Side Interactive Active State & Universal Select2 Script -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Dynamic Universal Select2 Auto-Initializer
      if (typeof $ !== 'undefined' && $.fn.select2) {
        $('select.select2, select[class*="select2"]').each(function () {
          const $el = $(this);
          if ($el.hasClass('select2-hidden-accessible')) return;

          const placeholder = $el.data('placeholder') || undefined;
          const allowClear = $el.data('allow-clear') !== undefined 
            ? Boolean($el.data('allow-clear')) 
            : (placeholder ? true : false);
          
          const minSearchAttr = $el.data('minimum-results-for-search');
          const minSearch = minSearchAttr !== undefined
            ? (String(minSearchAttr) === 'Infinity' ? Infinity : Number(minSearchAttr))
            : ($el.hasClass('select2-no-search') || $el.hasClass('select2-role') ? Infinity : 0);

          $el.select2({
            placeholder: placeholder,
            allowClear: allowClear,
            minimumResultsForSearch: minSearch,
            width: '100%'
          });
        });
      }

      // 2. Interactive Toggle for Category Pills
      const catPills = document.querySelectorAll('.category-pill');
      catPills.forEach(pill => {
        pill.addEventListener('click', () => {
          catPills.forEach(p => {
            p.classList.remove('bg-primary', 'text-white', 'shadow-primary/20');
            p.classList.add('bg-accent/60', 'text-gray-700');
          });
          pill.classList.remove('bg-accent/60', 'text-gray-700');
          pill.classList.add('bg-primary', 'text-white', 'shadow-primary/20');
        });
      });

      // 3. Interactive Toggle for City Pills
      const cityPills = document.querySelectorAll('.city-pill');
      cityPills.forEach(pill => {
        pill.addEventListener('click', () => {
          cityPills.forEach(p => {
            p.classList.remove('bg-primary', 'text-white', 'shadow-primary/20');
            p.classList.add('bg-accent/60', 'text-gray-700');
          });
          pill.classList.remove('bg-accent/60', 'text-gray-700');
          pill.classList.add('bg-primary', 'text-white', 'shadow-primary/20');
        });
      });
    });
  </script>

