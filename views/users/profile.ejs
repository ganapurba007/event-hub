<%- include('../../partials/header'); %>

<!-- ==================== MAIN USER PROFILE CONTAINER ==================== -->
<main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-7xl">

  <!-- PAGE HEADER & BREADCRUMB -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span>/</span>
        <span class="text-primary font-bold">My Profile</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight flex items-center gap-3">
        <span class="w-3.5 h-9 bg-primary rounded-full inline-block"></span>
        User Profile & Settings
      </h1>
      <p class="text-gray-500 text-sm sm:text-base mt-1">Manage your account information, update contact details, and view order stats</p>
    </div>

    <!-- Quick Actions -->
    <div class="flex items-center gap-3 self-start sm:self-auto">
      <a href="/my-orders" class="inline-flex items-center gap-2 bg-white hover:bg-bg-base text-gray-700 font-bold text-sm px-4 py-2.5 rounded-2xl border border-gray-200 shadow-sm transition-all duration-200 hover:scale-[1.02]">
        <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
        <span>My Orders</span>
      </a>
      <% if (userData && userData.role === 'creator') { %>
      <a href="/my-events" class="inline-flex items-center gap-2 bg-primary hover:bg-secondary text-white font-bold text-sm px-4 py-2.5 rounded-2xl shadow-md shadow-primary/20 transition-all duration-200 hover:scale-[1.02]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>My Events</span>
      </a>
      <% } %>
    </div>
  </div>

  <!-- SUCCESS ALERT BANNER -->
  <% if (typeof message !== 'undefined' && message) { %>
  <div class="mb-8 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl p-4 text-sm flex items-center justify-between gap-3 shadow-sm transition-all">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 font-bold">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <div>
        <h4 class="font-bold text-emerald-900">Success!</h4>
        <p class="text-xs sm:text-sm text-emerald-700"><%= message %></p>
      </div>
    </div>
    <button type="button" onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-600 p-1 rounded-lg transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <% } %>

  <!-- ERROR ALERT BANNER -->
  <% if (typeof error !== 'undefined' && error && ((Array.isArray(error) && error.length > 0) || typeof error === 'string')) { %>
  <div class="mb-8 bg-red-50 border border-red-200 text-red-700 rounded-2xl p-4 text-xs sm:text-sm flex items-start gap-3 shadow-sm">
    <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div class="space-y-1">
      <h4 class="font-bold">Profile Update Error</h4>
      <% if (Array.isArray(error)) { %>
      <ul class="list-disc list-inside space-y-0.5">
        <% error.forEach(msg => { %>
        <li><%= msg %></li>
        <% }); %>
      </ul>
      <% } else { %>
      <p><%= error %></p>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- PROFILE HERO CARD -->
  <div class="bg-gradient-to-r from-primary via-primary/90 to-secondary text-white rounded-3xl p-6 sm:p-8 shadow-xl shadow-primary/20 border border-primary/30 mb-8 relative overflow-hidden">
    <!-- Subtle Background Glow Effects -->
    <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute right-1/3 -top-10 w-48 h-48 bg-accent/20 rounded-full blur-xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">

      <!-- User Avatar & Core Identity -->
      <div class="flex items-center gap-5">
        <!-- Avatar Circle -->
        <div class="relative group">
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-3xl bg-white/20 backdrop-blur-md text-white font-black text-3xl sm:text-4xl border-2 border-white/40 flex items-center justify-center shadow-inner shrink-0 group-hover:scale-105 transition-transform duration-300">
            <% if (userData && userData.avatar) { %>
            <img src="<%= userData.avatar %>" alt="<%= userData.name %>" class="w-full h-full object-cover rounded-3xl" />
            <% } else { %>
            <%= (userData && userData.name) ? userData.name.charAt(0).toUpperCase() : 'U' %>
            <% } %>
          </div>
          <!-- Online / Active Status Badge -->
          <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-emerald-400 border-2 border-primary" title="Active Account"></span>
        </div>

        <!-- Name, Email, Role -->
        <div class="space-y-1">
          <div class="flex items-center gap-2.5 flex-wrap">
            <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
              <%= (userData && userData.name) ? userData.name : 'User' %>
            </h2>
            <% if (userData && userData.role) { %>
            <span class="inline-block text-[10px] font-extrabold uppercase px-3 py-1 bg-white/20 backdrop-blur-md text-white rounded-full border border-white/30 tracking-wider">
              <%= userData.role %>
            </span>
            <% } %>
          </div>

          <p class="text-sm text-accent/90 flex items-center gap-2 font-medium">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <span><%= (userData && userData.email) ? userData.email : '-' %></span>
          </p>

          <% if (userData && userData.phone) { %>
          <p class="text-xs text-accent/80 flex items-center gap-2 font-medium">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span><%= userData.phone %></span>
          </p>
          <% } %>
        </div>
      </div>

      <!-- Member Joined Date Badge -->
      <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/20 flex items-center gap-3 shrink-0 self-start md:self-auto">
        <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </div>
        <div>
          <p class="text-[10px] font-bold uppercase tracking-wider text-accent/80">Member Since</p>
          <p class="text-sm font-bold">
            <%= (userData && userData.created_at) ? new Date(userData.created_at).toLocaleDateString('id-ID', { month: 'short', year: 'numeric' }) : '2026' %>
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- STATS CARDS GRID (STATISTIK ORDER & EVENT) -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">

    <!-- 1. STAT: TOTAL ORDERS -->
    <div class="bg-white rounded-3xl p-6 border border-accent/40 shadow-lg shadow-gray-200/40 hover:shadow-xl transition-all duration-300 flex items-center justify-between group">
      <div class="space-y-1">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Total Orders</p>

        <div class="flex items-baseline gap-2">
          <h3 class="text-3xl font-extrabold text-gray-900 group-hover:text-primary transition-colors">
            <%= (stats && typeof stats.orders !== 'undefined') ? stats.orders : 0 %>
          </h3>
          <span class="text-xs font-semibold text-gray-500">tickets / orders</span>
        </div>

        <a href="/my-orders" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:underline pt-2">
          <span>View Order History</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0 border border-primary/20 shadow-inner group-hover:scale-110 transition-transform duration-300">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
        </svg>
      </div>
    </div>

    <!-- 2. STAT: TOTAL EVENTS CREATED -->
    <div class="bg-white rounded-3xl p-6 border border-accent/40 shadow-lg shadow-gray-200/40 hover:shadow-xl transition-all duration-300 flex items-center justify-between group">
      <div class="space-y-1">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Published Events</p>

        <div class="flex items-baseline gap-2">
          <h3 class="text-3xl font-extrabold text-gray-900 group-hover:text-primary transition-colors">
            <%= (stats && typeof stats.events !== 'undefined') ? stats.events : 0 %>
          </h3>
          <span class="text-xs font-semibold text-gray-500">events created</span>
        </div>

        <% if (userData && userData.role === 'creator') { %>
        <a href="/my-events" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:underline pt-2">
          <span>Manage Creator Events</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <% } else { %>
        <span class="inline-block text-xs font-medium text-gray-400 pt-2">Standard User Account</span>
        <% } %>
      </div>

      <div class="w-14 h-14 rounded-2xl bg-accent/60 text-primary flex items-center justify-center shrink-0 border border-primary/20 shadow-inner group-hover:scale-110 transition-transform duration-300">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    </div>

    <!-- 3. STAT: ACCOUNT ROLE & PERMISSIONS -->
    <div class="bg-white rounded-3xl p-6 border border-accent/40 shadow-lg shadow-gray-200/40 hover:shadow-xl transition-all duration-300 flex items-center justify-between group md:col-span-2 lg:col-span-1">
      <div class="space-y-1">
        <p class="text-xs font-bold uppercase tracking-wider text-gray-400">Account Type</p>

        <div class="flex items-center gap-2">
          <h3 class="text-2xl font-extrabold text-gray-900 capitalize">
            <%= (userData && userData.role) ? userData.role : 'User' %>
          </h3>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>
        </div>

        <p class="text-xs font-medium text-gray-500 pt-2">
          <%= (userData && userData.role === 'creator') ? 'Can create, publish, and host events' : 'Can browse, buy tickets, and attend events' %>
        </p>
      </div>

      <div class="w-14 h-14 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center shrink-0 border border-secondary/20 shadow-inner group-hover:scale-110 transition-transform duration-300">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      </div>
    </div>

  </div>

  <!-- ACCOUNT DETAILS EDITABLE FORM CARD SECTION -->
  <div class="bg-white rounded-3xl p-6 sm:p-8 border border-accent/40 shadow-xl shadow-gray-200/40 space-y-6">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-5">
      <div>
        <h3 class="text-xl font-extrabold text-gray-900 flex items-center gap-2.5">
          <span class="w-2.5 h-6 bg-primary rounded-full inline-block"></span>
          Edit Account Information
        </h3>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">Update your name, email address, or phone number below</p>
      </div>

      <form action="/logout" method="POST">
        <button type="submit" class="inline-flex items-center gap-2 text-xs font-bold text-red-600 hover:text-white bg-red-50 hover:bg-red-600 px-4 py-2.5 rounded-2xl border border-red-200 transition-all duration-200 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span>Logout</span>
        </button>
      </form>
    </div>

    <!-- UPDATE PROFILE FORM -->
    <form action="/profile" method="POST" class="space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

        <!-- 1. Full Name (Editable) -->
        <div class="space-y-1.5">
          <label for="name" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
            Full Name <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <input type="text" id="name" name="name" required placeholder="John Doe" class="w-full pl-11 pr-4 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 font-semibold text-sm transition-all" value="<%= (userData && userData.name) ? userData.name : '' %>" />
          </div>
        </div>

        <!-- 2. Email Address (Editable) -->
        <div class="space-y-1.5">
          <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
            Email Address <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <input type="email" id="email" name="email" required placeholder="name@example.com" class="w-full pl-11 pr-4 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 font-semibold text-sm transition-all" value="<%= (userData && userData.email) ? userData.email : '' %>" />
          </div>
        </div>

        <!-- 3. Phone Number (Editable) -->
        <div class="space-y-1.5">
          <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
            Phone Number <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <input type="tel" id="phone" name="phone" required placeholder="081234567890" class="w-full pl-11 pr-4 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 font-semibold text-sm transition-all" value="<%= (userData && userData.phone) ? userData.phone : '' %>" />
          </div>
        </div>

        <!-- 4. Account Role (Read-only Badge) -->
        <div class="space-y-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-400">
            Account Role
          </label>
          <div class="w-full px-4 py-3.5 bg-bg-base/40 border border-gray-200/80 rounded-2xl text-gray-700 font-bold text-sm flex items-center justify-between">
            <span class="capitalize"><%= (userData && userData.role) ? userData.role : 'User' %></span>
            <span class="text-[10px] uppercase font-extrabold px-2.5 py-0.5 bg-accent/60 text-primary rounded-full">System Role</span>
          </div>
        </div>

        <!-- 5. Registered Date (Read-only Info) -->
        <div class="space-y-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-400">
            Registered Date
          </label>
          <div class="w-full px-4 py-3.5 bg-bg-base/40 border border-gray-200/80 rounded-2xl text-gray-700 font-bold text-sm flex items-center justify-between">
            <span><%= (userData && userData.created_at) ? new Date(userData.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) : '-' %></span>
            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </div>

        <!-- 6. Account Status (Read-only Info) -->
        <div class="space-y-1.5">
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-400">
            Account Status
          </label>
          <div class="w-full px-4 py-3.5 bg-bg-base/40 border border-gray-200/80 rounded-2xl text-emerald-700 font-bold text-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span>Verified & Active</span>
            </div>
            <svg class="w-4 h-4 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>

      </div>

      <!-- Update Profile Submit Button -->
      <div class="pt-4 border-t border-gray-100 flex items-center justify-end">
        <button type="submit" class="bg-primary hover:bg-secondary text-white font-extrabold text-sm sm:text-base py-3.5 px-8 rounded-2xl shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/35 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center justify-center gap-2 cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          <span>Update Profile</span>
        </button>
      </div>

    </form>

  </div>

</main>
<!-- ==================== END MAIN USER PROFILE CONTAINER ==================== -->

<%- include('../../partials/footer'); %>
