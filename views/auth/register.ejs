<%- include('../../partials/header'); %>

<!-- ==================== MAIN REGISTER CONTAINER ==================== -->
<main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-6 flex items-center justify-center min-h-[calc(100vh-160px)]">

  <div class="w-full max-w-xl">

    <!-- REGISTER CARD -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-accent/40 shadow-xl shadow-gray-200/50 space-y-8">

      <!-- Card Header & Branding -->
      <div class="text-center space-y-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
          Create Your Account
        </h1>
        <p class="text-xs sm:text-sm text-gray-500 max-w-md mx-auto leading-relaxed">
          Join EventHub to discover incredible local events, purchase e-tickets, or publish your own events.
        </p>
      </div>

      <!-- ERROR ALERT BANNER -->
      <% if (typeof error !== 'undefined' && error && ((Array.isArray(error) && error.length > 0) || typeof error === 'string')) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-2xl p-4 text-xs sm:text-sm flex items-start gap-3">
        <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div class="space-y-1">
          <h4 class="font-bold">Registration Error</h4>
          <% if (Array.isArray(error)) { %>
          <ul class="list-disc list-inside space-y-0.5">
            <% error.forEach(msg => { %>
            <li><%= msg %></li>
            <% }); %>
          </ul>
          <% } else { %>
          <p><%= error %></p>
          <% } %>
        </div>
      </div>
      <% } %>

      <!-- REGISTER FORM -->
      <form action="/register" method="POST" class="space-y-5">

        <!-- 1. Full Name -->
        <div class="space-y-1.5">
          <label for="name" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
            Full Name <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <input type="text" id="name" name="name" placeholder="John Doe" required class="w-full pl-11 pr-4 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 placeholder-gray-400 text-sm font-medium transition-all" value="<% (typeof formData !== 'undefined' && formData.name) ? formData.name : '' %>" />
          </div>
        </div>

        <!-- 2. Email Address -->
        <div class="space-y-1.5">
          <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
            Email Address <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <input type="email" id="email" name="email" placeholder="name@example.com" required class="w-full pl-11 pr-4 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 placeholder-gray-400 text-sm font-medium transition-all" value="<% (typeof formData !== 'undefined' && formData.email) ? formData.email : '' %>" />
          </div>
        </div>

        <!-- 3. Phone Number -->
        <div class="space-y-1.5">
          <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
            Phone Number <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <input type="tel" id="phone" name="phone" placeholder="081234567890" required class="w-full pl-11 pr-4 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 placeholder-gray-400 text-sm font-medium transition-all" value="<% (typeof formData !== 'undefined' && formData.phone) ? formData.phone : '' %>" />
          </div>
        </div>

        <!-- 4. Password -->
        <div class="space-y-1.5">
          <label for="password" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
            Password <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <input type="password" id="password" name="password" placeholder="••••••••" required class="w-full pl-11 pr-12 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 placeholder-gray-400 text-sm font-medium transition-all" />

            <!-- Toggle Password Eye Button -->
            <button type="button" id="toggle-password" class="absolute inset-y-0 right-0 pr-4 flex items-center text-gray-400 hover:text-gray-600">
              <svg id="eye-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </button>
          </div>
        </div>

        <!-- 5. Account Role Dropdown -->
        <div class="space-y-1.5">
          <label for="role" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
            Account Role <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400 z-10">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <select name="role" required class="select2-role w-full pl-11 pr-10 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 text-sm font-medium transition-all appearance-none cursor-pointer">
              <option value="user" <% (typeof formData !== 'undefined' && formData.role === 'user') ? 'selected' : '' %>>User</option>
              <option value="creator" <% (typeof formData !== 'undefined' && formData.role === 'creator') ? 'selected' : '' %>>Creator</option>
            </select>
          </div>
        </div>

        <!-- Terms Agreement Checkbox -->
        <div class="flex items-start gap-2.5 pt-1">
          <input type="checkbox" id="agree-terms" required class="w-4 h-4 rounded text-primary focus:ring-primary border-gray-300 mt-0.5 cursor-pointer" />
          <label for="agree-terms" class="text-xs text-gray-600 leading-relaxed cursor-pointer">
            I agree to EventHub's <a href="/terms" target="_blank" class="text-primary font-bold hover:underline">Terms of Service</a> and <a href="/privacy" target="_blank" class="text-primary font-bold hover:underline">Privacy Policy</a>.
          </label>
        </div>

        <!-- Submit Button (Disabled until terms checked) -->
        <button type="submit" id="btn-register" disabled class="w-full bg-gray-300 text-gray-500 font-extrabold text-base py-4 rounded-2xl cursor-not-allowed transition-all duration-300 flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          <span>Create Account</span>
        </button>

      </form>

      <!-- Footer Link to Login -->
      <div class="text-center pt-2 border-t border-gray-100">
        <p class="text-xs sm:text-sm text-gray-500 font-medium">
          Already have an account?
          <a href="/login" class="text-primary font-bold hover:underline ml-1">
            Log In
          </a>
        </p>
      </div>

    </div>

  </div>

</main>
<!-- ==================== END MAIN CONTAINER ==================== -->

<!-- Interactive Password Toggle & Terms Checkbox Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {

    // 2. Password Toggle
    const pwdInput = document.getElementById('password');
    const toggleBtn = document.getElementById('toggle-password');

    if (toggleBtn && pwdInput) {
      toggleBtn.addEventListener('click', () => {
        const isPassword = pwdInput.type === 'password';
        pwdInput.type = isPassword ? 'text' : 'password';
      });
    }

    // 3. Terms Checkbox Toggle Submit Button State
    const agreeCheckbox = document.getElementById('agree-terms');
    const btnRegister = document.getElementById('btn-register');

    function toggleSubmitButton() {
      if (!agreeCheckbox || !btnRegister) return;
      if (agreeCheckbox.checked) {
        btnRegister.removeAttribute('disabled');
        btnRegister.className = "w-full bg-primary hover:bg-secondary text-white font-extrabold text-base py-4 rounded-2xl shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/35 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center justify-center gap-2 cursor-pointer";
      } else {
        btnRegister.setAttribute('disabled', 'disabled');
        btnRegister.className = "w-full bg-gray-300 text-gray-500 font-extrabold text-base py-4 rounded-2xl cursor-not-allowed transition-all duration-300 flex items-center justify-center gap-2";
      }
    }

    if (agreeCheckbox) {
      agreeCheckbox.addEventListener('change', toggleSubmitButton);
      toggleSubmitButton();
    }
  });
</script>

<%- include('../../partials/footer'); %>