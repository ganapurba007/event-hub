<%- include('../partials/header'); %>

  <!-- ==================== MAIN CONTENT CONTAINER ==================== -->
  <main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-7xl">

    <% if (typeof message !=='undefined' && message) { %>
      <!-- SUCCESS ALERT BANNER -->
      <div
        class="mb-8 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl p-4 text-sm flex items-center justify-between gap-3 shadow-sm transition-all">
        <div class="flex items-center gap-3">
          <div
            class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-emerald-900">
              <%= message %>
            </h4>
          </div>
        </div>
        <button type="button" onclick="this.parentElement.remove()"
          class="text-emerald-400 hover:text-emerald-600 p-1 rounded-lg transition-colors" aria-label="Close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <% } %>

        <!-- ==================== HERO BANNER & SEARCH SECTION ==================== -->
        <section
          class="relative bg-gradient-to-br from-primary via-[#2b598c] to-secondary text-white rounded-3xl p-6 sm:p-10 lg:p-12 shadow-2xl mb-12 overflow-hidden">
          <!-- Decorative background blur elements -->
          <div class="absolute -right-16 -bottom-16 w-80 h-80 bg-white/10 rounded-full blur-3xl pointer-events-none">
          </div>
          <div class="absolute -left-16 -top-16 w-72 h-72 bg-accent/20 rounded-full blur-3xl pointer-events-none"></div>

          <div class="relative z-10 max-w-3xl space-y-6">
            <div
              class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-white/15 backdrop-blur-md rounded-full text-xs font-extrabold uppercase tracking-wider text-emerald-200 border border-white/20 shadow-sm">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              Discover Events Across Indonesia
            </div>

            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight sm:leading-tight">
              Discover & Book Unforgettable <span class="text-accent underline decoration-accent/40">Local Events</span>
            </h1>

            <p class="text-accent/90 text-sm sm:text-base lg:text-lg max-w-2xl leading-relaxed font-normal">
              Explore live concerts, tech summits, art exhibitions, and sports events near you. Book instant barcode
              e-tickets securely in seconds.
            </p>

            <!-- HERO SEARCH FORM -->
            <form action="/events" method="GET"
              class="bg-white/10 backdrop-blur-xl p-2.5 sm:p-3 rounded-2xl sm:rounded-3xl border border-white/25 shadow-xl max-w-2xl">
              <div class="flex flex-col sm:flex-row gap-2.5">
                <div class="relative flex-grow">
                  <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                    <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                  </div>
                  <input type="text" name="search" placeholder="Search by event title, keyword or city..."
                    class="w-full pl-11 pr-4 py-3.5 bg-white rounded-xl sm:rounded-2xl text-gray-900 placeholder-gray-400 text-sm sm:text-base font-medium focus:outline-none focus:ring-2 focus:ring-accent shadow-inner" />
                </div>

                <button type="submit"
                  class="bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold px-7 py-3.5 rounded-xl sm:rounded-2xl transition-all duration-200 flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 hover:scale-[1.02] cursor-pointer shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                  </svg>
                  <span>Explore Events</span>
                </button>
              </div>
            </form>

            <!-- Trust Badges -->
            <div class="flex items-center gap-6 pt-2 text-xs font-semibold text-white/80 flex-wrap">
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                Instant E-Tickets
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                Secure Xendit Payment
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Real-time Availability
              </span>
            </div>
          </div>
        </section>

        <!-- ==================== POPULAR CATEGORIES GRID ==================== -->
        <section class="mb-14">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2.5">
                <span class="w-3.5 h-8 bg-primary rounded-full inline-block"></span>
                Explore Popular Categories
              </h2>
              <p class="text-gray-500 text-sm mt-1">Browse events by category tailored to your interest</p>
            </div>
            <a href="/events"
              class="text-xs sm:text-sm font-bold text-primary hover:text-secondary flex items-center gap-1 transition-colors">
              <span>View All</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <!-- Category Cards Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-5">
            <% if (typeof categories !=='undefined' && categories && categories.length> 0) { %>
              <% categories.slice(0, 6).forEach(category=> { %>
                <a href="/events?category=<%= category.id %>"
                  class="bg-white rounded-3xl p-5 border border-gray-100 shadow-md shadow-gray-200/40 hover:shadow-xl hover:shadow-primary/15 hover:border-primary/40 transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center text-center group">
                  <div
                    class="w-14 h-14 rounded-2xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white flex items-center justify-center mb-3 transition-all duration-300 text-2xl shadow-inner">
                    <i class="<%= category.icon || 'bi bi-tags' %>"></i>
                  </div>
                  <h3 class="font-extrabold text-gray-800 text-sm group-hover:text-primary transition-colors">
                    <%= category.name %>
                  </h3>
                  <span class="text-[11px] text-gray-400 font-semibold mt-1">Explore →</span>
                </a>
                <% }); %>
                  <% } else { %>
                    <!-- Static Fallback Categories -->
                    <a href="/events?category=1"
                      class="bg-white rounded-3xl p-5 border border-gray-100 shadow-md shadow-gray-200/40 hover:shadow-xl hover:shadow-primary/15 hover:border-primary/40 transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center text-center group">
                      <div
                        class="w-14 h-14 rounded-2xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white flex items-center justify-center mb-3 transition-all duration-300 text-2xl">
                        <i class="bi bi-music-note-beamed"></i>
                      </div>
                      <h3 class="font-extrabold text-gray-800 text-sm group-hover:text-primary transition-colors">Music
                      </h3>
                      <span class="text-[11px] text-gray-400 font-semibold mt-1">Explore →</span>
                    </a>

                    <a href="/events?category=2"
                      class="bg-white rounded-3xl p-5 border border-gray-100 shadow-md shadow-gray-200/40 hover:shadow-xl hover:shadow-primary/15 hover:border-primary/40 transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center text-center group">
                      <div
                        class="w-14 h-14 rounded-2xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white flex items-center justify-center mb-3 transition-all duration-300 text-2xl">
                        <i class="bi bi-cpu"></i>
                      </div>
                      <h3 class="font-extrabold text-gray-800 text-sm group-hover:text-primary transition-colors">
                        Technology</h3>
                      <span class="text-[11px] text-gray-400 font-semibold mt-1">Explore →</span>
                    </a>

                    <a href="/events?category=3"
                      class="bg-white rounded-3xl p-5 border border-gray-100 shadow-md shadow-gray-200/40 hover:shadow-xl hover:shadow-primary/15 hover:border-primary/40 transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center text-center group">
                      <div
                        class="w-14 h-14 rounded-2xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white flex items-center justify-center mb-3 transition-all duration-300 text-2xl">
                        <i class="bi bi-trophy"></i>
                      </div>
                      <h3 class="font-extrabold text-gray-800 text-sm group-hover:text-primary transition-colors">Sports
                      </h3>
                      <span class="text-[11px] text-gray-400 font-semibold mt-1">Explore →</span>
                    </a>

                    <a href="/events?category=4"
                      class="bg-white rounded-3xl p-5 border border-gray-100 shadow-md shadow-gray-200/40 hover:shadow-xl hover:shadow-primary/15 hover:border-primary/40 transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center text-center group">
                      <div
                        class="w-14 h-14 rounded-2xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white flex items-center justify-center mb-3 transition-all duration-300 text-2xl">
                        <i class="bi bi-palette"></i>
                      </div>
                      <h3 class="font-extrabold text-gray-800 text-sm group-hover:text-primary transition-colors">
                        Exhibition</h3>
                      <span class="text-[11px] text-gray-400 font-semibold mt-1">Explore →</span>
                    </a>

                    <a href="/events?category=5"
                      class="bg-white rounded-3xl p-5 border border-gray-100 shadow-md shadow-gray-200/40 hover:shadow-xl hover:shadow-primary/15 hover:border-primary/40 transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center text-center group">
                      <div
                        class="w-14 h-14 rounded-2xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white flex items-center justify-center mb-3 transition-all duration-300 text-2xl">
                        <i class="bi bi-people"></i>
                      </div>
                      <h3 class="font-extrabold text-gray-800 text-sm group-hover:text-primary transition-colors">
                        Community</h3>
                      <span class="text-[11px] text-gray-400 font-semibold mt-1">Explore →</span>
                    </a>

                    <a href="/events?category=6"
                      class="bg-white rounded-3xl p-5 border border-gray-100 shadow-md shadow-gray-200/40 hover:shadow-xl hover:shadow-primary/15 hover:border-primary/40 transition-all duration-300 transform hover:-translate-y-1.5 flex flex-col items-center text-center group">
                      <div
                        class="w-14 h-14 rounded-2xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white flex items-center justify-center mb-3 transition-all duration-300 text-2xl">
                        <i class="bi bi-grid"></i>
                      </div>
                      <h3 class="font-extrabold text-gray-800 text-sm group-hover:text-primary transition-colors">Others
                      </h3>
                      <span class="text-[11px] text-gray-400 font-semibold mt-1">Explore →</span>
                    </a>
                    <% } %>
          </div>
        </section>

        <!-- ==================== SECTION: FEATURED & CITY EVENTS ==================== -->
        <section class="mb-14">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-2.5">
                <span class="w-3.5 h-8 bg-primary rounded-full inline-block"></span>
                Featured Events by City
              </h2>
              <p class="text-gray-500 text-sm mt-1">Filter top-rated upcoming events by city</p>
            </div>
            <a href="/events"
              class="text-xs sm:text-sm font-bold text-primary hover:text-secondary flex items-center gap-1 transition-colors">
              <span>Browse All Events</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <!-- City Filter Tabs Group -->
          <div class="flex items-center gap-3 overflow-x-auto scrollbar-none pb-4" id="city-tabs-group">
            <button type="button"
              class="city-tab-btn whitespace-nowrap px-5 py-3 rounded-2xl text-xs sm:text-sm font-extrabold transition-all duration-300 flex items-center gap-2 shadow-sm bg-primary text-white shadow-primary/20 hover:scale-105 shrink-0"
              data-city="all">
              <svg class="w-4 h-4 text-white shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              <span>All Cities</span>
            </button>

            <% const popularCitiesList=(typeof cities !=='undefined' && cities && cities.length> 0)
              ? cities
              : ['Jakarta', 'Bandung', 'Surabaya', 'Yogyakarta', 'Bali'];
              %>
              <% popularCitiesList.forEach(city=> { %>
                <% const cityName=typeof city==='object' && city !==null ? (city.city || city.name) : city; %>
                  <% if (cityName) { %>
                    <button type="button"
                      class="city-tab-btn bg-white hover:bg-primary text-gray-700 hover:text-white border border-gray-200 hover:border-primary shadow-sm hover:shadow-primary/20 whitespace-nowrap px-5 py-3 rounded-2xl text-xs sm:text-sm font-bold transition-all duration-300 transform hover:-translate-y-0.5 flex items-center gap-2 shrink-0 group"
                      data-city="<%= cityName %>">
                      <svg class="w-4 h-4 text-primary group-hover:text-white transition-colors shrink-0" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <span>
                        <%= cityName %>
                      </span>
                    </button>
                    <% } %>
                      <% }); %>
          </div>

          <!-- Responsive Grid for Events -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="latest-events-grid">
            <% const allEventItems=(typeof latestEvents !=='undefined' && latestEvents && latestEvents.length> 0)
              ? latestEvents
              : ((typeof upcomingEvents !== 'undefined' && upcomingEvents) ? upcomingEvents : []);
              %>
              <% if (allEventItems && allEventItems.length> 0) { %>
                <% allEventItems.forEach(event=> { %>
                  <a href="/events/<%= event.id %>" class="latest-event-card block" data-city="<%= event.city || '' %>">
                    <div
                      class="bg-white rounded-3xl border border-gray-100 shadow-md shadow-gray-200/40 hover:shadow-xl hover:shadow-primary/15 transition-all duration-300 transform hover:-translate-y-1.5 overflow-hidden flex flex-col h-full group">

                      <!-- Poster Image -->
                      <div class="relative w-full aspect-[16/9] overflow-hidden bg-gray-100">
                        <img src="<%= event.image_path %>" alt="<%= event.title %>"
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                          onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1501281668745-f7f57925c3b4?auto=format&fit=crop&w=800&q=80';" />

                        <!-- Category Badge -->
                        <div class="absolute top-3 left-3">
                          <span
                            class="inline-block bg-accent/95 backdrop-blur-sm text-gray-900 text-xs font-extrabold px-3 py-1 rounded-full border border-white/60 shadow-sm">
                            <%= (event.Category && event.Category.name) ? event.Category.name : 'Event' %>
                          </span>
                        </div>

                        <!-- Price Badge -->
                        <% if (typeof event.price !=='undefined' && event.price !==null) { %>
                          <div class="absolute top-3 right-3">
                            <span
                              class="inline-block bg-primary/90 backdrop-blur-sm text-white text-xs font-extrabold px-3 py-1 rounded-full border border-white/40 shadow-sm">
                              <%= Number(event.price)===0 ? 'Free' : ('Rp' +
                                Number(event.price).toLocaleString('id-ID')) %>
                            </span>
                          </div>
                          <% } %>
                      </div>

                      <!-- Card Content Body -->
                      <div class="p-5 sm:p-6 flex flex-col flex-grow justify-between gap-4">
                        <div class="space-y-2">
                          <h3
                            class="text-lg font-extrabold text-gray-900 group-hover:text-primary transition-colors duration-200 line-clamp-2 leading-snug">
                            <%= event.title %>
                          </h3>
                          <% if (event.description) { %>
                            <p class="text-xs sm:text-sm text-gray-500 line-clamp-2 leading-relaxed font-normal">
                              <%= event.description %>
                            </p>
                            <% } %>
                        </div>

                        <div class="space-y-2.5 pt-3 border-t border-gray-100 text-xs sm:text-sm font-medium">
                          <!-- Date -->
                          <div class="flex items-center text-gray-700 gap-2 font-semibold">
                            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor"
                              viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span>
                              <%= event.event_date ? new Date(event.event_date).toLocaleDateString('en-US', {
                                weekday:'short', day: 'numeric' , month: 'short' , year: 'numeric' }) : 'TBA' %>
                            </span>
                          </div>

                          <!-- Venue & City -->
                          <div class="flex items-center text-gray-500 gap-2">
                            <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor"
                              viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span class="truncate">
                              <%= event.venue || 'Venue TBA' %>, <strong class="font-bold text-gray-800">
                                  <%= event.city || 'Indonesia' %>
                                </strong>
                            </span>
                          </div>
                        </div>

                        <div class="pt-2 flex items-center justify-between text-xs border-t border-gray-50">
                          <span class="text-primary font-extrabold group-hover:underline">Book Ticket Now →</span>
                          <span class="text-gray-400 font-semibold">
                            <%= event.available_tickets> 0 ? (event.available_tickets + ' seats left') : 'Sold Out' %>
                          </span>
                        </div>
                      </div>
                    </div>
                  </a>
                  <% }); %>
                    <% } %>
          </div>

          <!-- Empty State Message when no events match the selected city -->
          <div id="no-latest-events-msg"
            class="hidden text-center py-12 bg-white rounded-3xl border border-gray-100 shadow-sm mt-4">
            <div class="w-12 h-12 rounded-full bg-accent/40 text-primary mx-auto flex items-center justify-center mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <h4 class="text-lg font-bold text-gray-800">No Events Found</h4>
            <p class="text-gray-500 text-sm mt-1">There are currently no events scheduled for the selected city.</p>
          </div>
        </section>

        <!-- ==================== PLATFORM FEATURES / WHY EVENTHUB ==================== -->
        <section
          class="mb-14 bg-gradient-to-br from-bg-base/70 via-accent/30 to-bg-base/80 rounded-3xl p-8 sm:p-10 border border-accent/60 shadow-lg shadow-gray-200/30">
          <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Why Choose EventHub?</h2>
            <p class="text-gray-500 text-sm">Empowering communities with seamless event discovery and instant
              e-ticketing</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
            <!-- Feature 1 -->
            <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-md space-y-3">
              <div
                class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center text-xl font-bold">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 002 2 2 2 0 010 4 2 2 0 00-2 2v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 00-2-2 2 2 0 010-4 2 2 0 002-2V7a2 2 0 00-2-2H5z" />
                </svg>
              </div>
              <h3 class="text-base font-extrabold text-gray-900">Instant Barcode E-Tickets</h3>
              <p class="text-xs text-gray-500 leading-relaxed font-normal">
                Get your verified e-ticket pass with dynamic QR codes immediately upon payment confirmation.
              </p>
            </div>

            <!-- Feature 2 -->
            <div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-md space-y-3">
              <div
