<%- include('../../partials/header'); %>

<!-- ==================== MAIN CHECKOUT CONTAINER ==================== -->
<main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-7xl">

  <!-- BREADCRUMB & BACK BUTTON -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span>/</span>
        <a href="/events" class="hover:text-primary transition-colors">Events</a>
        <span>/</span>
        <a href="/events/<%= event.id %>" class="hover:text-primary transition-colors truncate max-w-[150px] sm:max-w-xs"><%= event.title %></a>
        <span>/</span>
        <span class="text-primary font-bold">Checkout</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight flex items-center gap-3">
        <span class="w-3.5 h-9 bg-primary rounded-full inline-block"></span>
        Event Ticket Checkout
      </h1>
      <p class="text-gray-500 text-sm sm:text-base mt-1">Complete your ticket details to proceed to payment</p>
    </div>

    <a href="/events/<%= event.id %>" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-primary bg-white hover:bg-bg-base px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all duration-200 self-start sm:self-auto hover:scale-[1.02]">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>Back to Event</span>
    </a>
  </div>

  <!-- ERROR ALERT BANNER -->
  <% if (typeof error !== 'undefined' && error && ((Array.isArray(error) && error.length > 0) || typeof error === 'string')) { %>
  <div class="mb-8 bg-red-50 border border-red-200 text-red-700 rounded-2xl p-4 text-xs sm:text-sm flex items-start gap-3 shadow-sm">
    <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div class="space-y-1">
      <h4 class="font-bold">Checkout Error</h4>
      <% if (Array.isArray(error)) { %>
      <ul class="list-disc list-inside space-y-0.5">
        <% error.forEach(msg => { %>
        <li><%= msg %></li>
        <% }); %>
      </ul>
      <% } else { %>
      <p><%= error %></p>
      <% } %>
    </div>
  </div>
  <% } %>

  <!-- CHECKOUT MAIN FORM GRID -->
  <form action="/orders" method="POST">
    <input type="hidden" name="event_id" value="<%= event.id %>" />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- LEFT COLUMN: ATTENDEE CONTACT INFORMATION (7 COLS ON LG) -->
      <div class="lg:col-span-7 space-y-6">

        <!-- Attendee Form Card -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-accent/40 shadow-xl shadow-gray-200/40 space-y-6">
          <div class="border-b border-gray-100 pb-4">
            <h3 class="text-xl font-extrabold text-gray-900 flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-sm font-black">
                1
              </div>
              Attendee Contact Details
            </h3>
            <p class="text-xs sm:text-sm text-gray-500 mt-1">Your e-ticket will be sent to the email & phone number below</p>
          </div>

          <!-- 1. Full Name -->
          <div class="space-y-1.5">
            <label for="name" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
              Full Name <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <input type="text" id="attendee_name" name="attendee_name" required placeholder="John Doe" class="w-full pl-11 pr-4 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 placeholder-gray-400 text-sm font-medium transition-all" value="<%= (typeof formData !== 'undefined' && formData && formData.attendee_name) ? formData.attendee_name : '' %>" />
            </div>
          </div>

          <!-- 2. Email Address -->
          <div class="space-y-1.5">
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
              Email Address <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <input type="email" id="attendee_email" name="attendee_email" required placeholder="name@example.com" class="w-full pl-11 pr-4 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 placeholder-gray-400 text-sm font-medium transition-all" value="<%= (typeof formData !== 'undefined' && formData && formData.attendee_email) ? formData.attendee_email : '' %>" />
            </div>
          </div>

          <!-- 3. Phone Number -->
          <div class="space-y-1.5">
            <label for="phone" class="block text-xs font-bold uppercase tracking-wider text-gray-600">
              Phone Number <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <input type="tel" id="attendee_phone" name="attendee_phone" required placeholder="081234567890" class="w-full pl-11 pr-4 py-3.5 bg-bg-base/40 border border-gray-200 rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white text-gray-800 placeholder-gray-400 text-sm font-medium transition-all" value="<%= (typeof formData !== 'undefined' && formData && formData.attendee_phone) ? formData.attendee_phone : '' %>" />
            </div>
          </div>
        </div>

        <!-- Payment Instructions Note -->
        <div class="bg-primary/5 rounded-3xl p-5 sm:p-6 border border-primary/20 flex items-start gap-4">
          <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <div class="space-y-1">
            <h4 class="text-sm font-bold text-gray-900">Secure Payment Guaranteed</h4>
            <p class="text-xs text-gray-500 leading-relaxed">
              By clicking "Confirm & Complete Order", your booking will be confirmed and an e-ticket barcode will be generated automatically.
            </p>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: ORDER SUMMARY & QUANTITY / TOTAL PRICE (5 COLS ON LG) -->
      <div class="lg:col-span-5 space-y-6 lg:sticky lg:top-24">

        <!-- Order Summary Card -->
        <div class="bg-white rounded-3xl p-6 sm:p-7 border border-accent/60 shadow-xl shadow-gray-200/50 space-y-6">

          <div class="border-b border-gray-100 pb-4">
            <h3 class="text-xl font-extrabold text-gray-900 flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-sm font-black">
                2
              </div>
              Order Summary
            </h3>
          </div>

          <!-- Event Preview Mini Card -->
          <div class="flex items-center gap-4 bg-bg-base/40 rounded-2xl p-3.5 border border-gray-200/60">
            <img src="<%= event.image_path %>" alt="<%= event.title %>" class="w-20 h-20 rounded-xl object-cover shrink-0 border border-gray-200" />
            <div class="space-y-1 overflow-hidden">
              <span class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 bg-accent/60 text-primary rounded-full">
                <%= (event.Category && event.Category.name) ? event.Category.name : 'Event' %>
              </span>
              <h4 class="text-sm font-bold text-gray-900 truncate"><%= event.title %></h4>
              <p class="text-xs text-gray-500 flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="truncate"><%= event.venue %>, <%= event.city %></span>
              </p>
            </div>
          </div>

          <!-- Quantity Counter Selector (Cut from detail.ejs) -->
          <% const avail = event.available_tickets || 0; %>
          <% const ticketPrice = Number(event.price || 0); %>
          <% const isSoldOut = avail <= 0; %>

          <div class="space-y-2.5 pt-2 border-t border-gray-100">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold uppercase tracking-wider text-gray-600">
                Ticket Quantity
              </label>
              <span class="text-xs text-gray-400 font-medium">Max: <%= avail %> seats</span>
            </div>

            <div class="flex items-center justify-between bg-bg-base/60 border border-gray-200 rounded-2xl p-1.5">
              <button type="button" id="btn-minus" class="w-10 h-10 rounded-xl bg-white hover:bg-accent/50 text-gray-700 font-bold flex items-center justify-center transition-all border border-gray-200/80 shadow-sm disabled:opacity-40 cursor-pointer">
                -
              </button>
              <input type="number" id="ticket-qty" name="quantity" value="1" min="1" max="<%= avail %>" class="w-16 text-center font-extrabold text-lg bg-transparent text-gray-800 focus:outline-none" readonly />
              <button type="button" id="btn-plus" class="w-10 h-10 rounded-xl bg-white hover:bg-accent/50 text-gray-700 font-bold flex items-center justify-center transition-all border border-gray-200/80 shadow-sm disabled:opacity-40 cursor-pointer">
                +
              </button>
            </div>
          </div>

          <!-- Price Calculation Breakdown -->
          <div class="space-y-2.5 pt-4 border-t border-gray-100 text-xs sm:text-sm">
            <div class="flex items-center justify-between text-gray-500 font-medium">
              <span>Price per ticket</span>
              <span class="font-bold text-gray-800">
                <%= ticketPrice === 0 ? 'Free' : ('Rp' + ticketPrice.toLocaleString('id-ID')) %>
              </span>
            </div>
            <div class="flex items-center justify-between text-gray-500 font-medium">
              <span>Quantity</span>
              <span id="qty-multiplier-display" class="font-bold text-gray-800">1x</span>
            </div>

            <!-- Total Amount Display (Cut from detail.ejs) -->
            <div class="bg-accent/30 rounded-2xl p-4 border border-accent/60 flex items-center justify-between mt-3">
              <span class="text-xs font-bold uppercase tracking-wider text-gray-700">Total Price</span>
              <span id="total-price-display" class="text-2xl font-extrabold text-primary">
                <%= ticketPrice === 0 ? 'Free' : ('Rp' + ticketPrice.toLocaleString('id-ID')) %>
              </span>
            </div>
          </div>

          <!-- Submit Order Button -->
          <% if (!isSoldOut) { %>
          <button type="submit" class="w-full bg-primary hover:bg-secondary text-white font-extrabold text-base py-4 rounded-2xl shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/35 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center justify-center gap-2 cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Confirm & Complete Order</span>
          </button>
          <% } else { %>
          <button type="button" disabled class="w-full bg-gray-200 text-gray-400 font-extrabold text-base py-4 rounded-2xl cursor-not-allowed flex items-center justify-center gap-2">
            <span>Event Sold Out</span>
          </button>
          <% } %>

        </div>

      </div>

    </div>
  </form>

</main>
<!-- ==================== END MAIN CHECKOUT CONTAINER ==================== -->

<!-- Interactive Quantity & Price Calculation Script (Cut & Enhanced from detail.ejs) -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const qtyInput = document.getElementById('ticket-qty');
    const btnMinus = document.getElementById('btn-minus');
    const btnPlus = document.getElementById('btn-plus');
    const totalPriceDisplay = document.getElementById('total-price-display');
    const qtyMultiplierDisplay = document.getElementById('qty-multiplier-display');
    const unitPrice = <%= Number(event.price || 0) %>;
    const maxQty = <%= Number(event.available_tickets || 0) %>;

    function updatePrice() {
      if (!qtyInput) return;
      let qty = parseInt(qtyInput.value) || 1;
      if (qty < 1) qty = 1;
      if (qty > maxQty) qty = maxQty;
      qtyInput.value = qty;

      if (btnMinus) btnMinus.disabled = (qty <= 1);
      if (btnPlus) btnPlus.disabled = (qty >= maxQty);

      if (qtyMultiplierDisplay) {
        qtyMultiplierDisplay.textContent = qty + 'x';
      }

      if (totalPriceDisplay) {
        if (unitPrice === 0) {
          totalPriceDisplay.textContent = 'Free';
        } else {
          const total = unitPrice * qty;
          totalPriceDisplay.textContent = 'Rp' + total.toLocaleString('id-ID');
        }
      }
    }

    if (btnMinus) {
      btnMinus.addEventListener('click', () => {
        let qty = parseInt(qtyInput.value) || 1;
        if (qty > 1) {
          qtyInput.value = qty - 1;
          updatePrice();
        }
      });
    }

    if (btnPlus) {
      btnPlus.addEventListener('click', () => {
        let qty = parseInt(qtyInput.value) || 1;
        if (qty < maxQty) {
          qtyInput.value = qty + 1;
          updatePrice();
        }
      });
    }

    updatePrice();
  });
</script>

<%- include('../../partials/footer'); %>