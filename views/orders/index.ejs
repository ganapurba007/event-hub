<%- include('../../partials/header'); %>

<!-- ==================== MAIN MY ORDERS CONTAINER ==================== -->
<main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-7xl">

  <!-- PAGE HEADER & BREADCRUMB -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span>/</span>
        <span class="text-primary font-bold">My Orders</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight flex items-center gap-3">
        <span class="w-3.5 h-9 bg-primary rounded-full inline-block"></span>
        My Purchased Tickets & Orders
      </h1>
      <p class="text-gray-500 text-sm sm:text-base mt-1">View your order history, download e-tickets, and event details</p>
    </div>

    <a href="/events" class="inline-flex items-center gap-2 bg-primary hover:bg-secondary text-white font-bold text-sm px-5 py-3 rounded-2xl shadow-md shadow-primary/20 hover:shadow-lg transition-all duration-200 self-start md:self-auto hover:scale-[1.02]">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <span>Browse More Events</span>
    </a>
  </div>

  <!-- SUCCESS ALERT BANNER -->
  <% if (typeof message !== 'undefined' && message) { %>
  <div class="mb-8 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-2xl p-4 text-sm flex items-center justify-between gap-3 shadow-sm">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 font-bold">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <div>
        <h4 class="font-bold text-emerald-900">Success!</h4>
        <p class="text-xs sm:text-sm text-emerald-700"><%= message %></p>
      </div>
    </div>
    <button type="button" onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-emerald-600 p-1 rounded-lg transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
  <% } %>

  <!-- ORDERS LIST GRID -->
  <% if (typeof orders !== 'undefined' && orders && orders.length > 0) { %>
  <div class="space-y-6">
    <% orders.forEach(order => { %>
    <% const event = order.Event; %>
    <div class="bg-white rounded-3xl p-6 border border-accent/40 shadow-lg shadow-gray-200/40 hover:shadow-xl transition-all duration-300">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">

        <!-- Left: Event Image & Details -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-5 flex-grow">
          <div class="w-full sm:w-28 h-28 rounded-2xl overflow-hidden bg-gray-100 shrink-0 border border-gray-100 shadow-sm">
            <img src="<%= (event && event.image_path) ? event.image_path : '/images/placeholder.jpg' %>" alt="<%= (event && event.title) ? event.title : 'Event' %>" class="w-full h-full object-cover" />
          </div>

          <div class="space-y-1.5 flex-grow">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 bg-accent/60 text-primary rounded-full border border-primary/20">
                <%= (event && event.Category && event.Category.name) ? event.Category.name : 'Event' %>
              </span>
              <span class="text-xs text-gray-400 font-medium">Order #<%= order.id %> • <%= new Date(order.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
            </div>

            <h3 class="text-lg sm:text-xl font-bold text-gray-900">
              <%= (event && event.title) ? event.title : 'Event Title' %>
            </h3>

            <div class="flex items-center gap-4 text-xs font-semibold text-gray-600 flex-wrap">
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <span><%= (event && event.event_date) ? new Date(event.event_date).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short' }) : 'TBA' %></span>
              </div>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span><%= (event && event.venue) ? event.venue : 'Venue' %>, <%= (event && event.city) ? event.city : '' %></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Quantity, Price & Status -->
        <div class="flex flex-col sm:flex-row lg:flex-col sm:items-center lg:items-end justify-between gap-3 border-t lg:border-t-0 border-gray-100 pt-4 lg:pt-0 shrink-0">
          <div class="text-left sm:text-right">
            <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400">Total Amount</span>
            <div class="text-xl font-extrabold text-primary">
              <%= Number(order.total_amount) === 0 ? 'Free' : ('Rp' + Number(order.total_amount).toLocaleString('id-ID')) %>
            </div>
            <p class="text-xs text-gray-500 font-medium"><%= order.quantity %> ticket(s)</p>
          </div>

          <!-- Status Badge -->
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-emerald-50 text-emerald-700 border border-emerald-200 self-start sm:self-auto">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <%= order.status || 'Confirmed' %>
          </span>
        </div>

      </div>

      <!-- Tickets Barcode / Ticket Codes Box -->
      <% if (order.Tickets && order.Tickets.length > 0) { %>
      <div class="mt-5 pt-4 border-t border-gray-100 bg-bg-base/40 rounded-2xl p-4">
        <span class="text-xs font-bold uppercase tracking-wider text-gray-500 block mb-2">E-Ticket Barcodes & Codes:</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <% order.Tickets.forEach(ticket => { %>
          <div class="bg-white p-3 rounded-xl border border-gray-200 shadow-sm flex items-center justify-between">
            <div class="space-y-0.5">
              <p class="text-[10px] text-gray-400 font-bold uppercase">Attendee: <%= ticket.attendee_name %></p>
              <p class="text-xs font-mono font-extrabold text-primary tracking-wider"><%= ticket.ticket_code %></p>
            </div>
            <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center font-bold text-xs">
              <i class="bi bi-qr-code"></i>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
      <% } %>

    </div>
    <% }); %>
  </div>
  <% } else { %>
  <!-- Empty State Message -->
  <div class="text-center py-16 bg-white rounded-3xl border border-gray-100 shadow-sm">
    <div class="w-16 h-16 rounded-full bg-accent/40 text-primary mx-auto flex items-center justify-center mb-4">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
    </div>
    <h3 class="text-xl font-bold text-gray-800">No Purchased Tickets Yet</h3>
    <p class="text-gray-500 text-sm mt-1.5 max-w-md mx-auto">You haven't bought any event tickets yet. Explore exciting events in your city and book your first ticket!</p>
    <a href="/events" class="inline-block mt-5 px-6 py-2.5 bg-primary text-white font-semibold rounded-xl transition-all shadow-md shadow-primary/20 hover:scale-105">
      Browse Events Now
    </a>
  </div>
  <% } %>

</main>
<!-- ==================== END MY ORDERS CONTAINER ==================== -->

<%- include('../../partials/footer'); %>
