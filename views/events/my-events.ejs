<%- include('../../partials/header'); %>

<!-- ==================== MAIN MY EVENTS CONTAINER ==================== -->
<main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-7xl">

  <%- include('../../partials/alert'); %>

  <!-- PAGE HEADER & BREADCRUMB -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
      <div class="flex items-center gap-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <span>/</span>
        <span class="text-primary font-bold">My Events</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight flex items-center gap-3">
        <span class="w-3.5 h-9 bg-primary rounded-full inline-block"></span>
        My Created Events
      </h1>
      <p class="text-gray-500 text-sm sm:text-base mt-1">Manage, monitor sales, and view performance for all your published events</p>
    </div>

    <!-- Create Event Action Button -->
    <a href="/events/create" class="inline-flex items-center gap-2 bg-primary hover:bg-secondary text-white font-extrabold text-sm px-6 py-3 rounded-2xl shadow-lg shadow-primary/25 hover:shadow-xl hover:scale-[1.02] transition-all duration-200 self-start md:self-auto">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      <span>Create New Event</span>
    </a>
  </div>

  <% 
    const totalEvents = (typeof events !== 'undefined' && events) ? events.length : 0;
    let totalRevenue = 0;
    let totalTicketsSold = 0;

    if (typeof events !== 'undefined' && events && events.length > 0) {
      events.forEach(evt => {
        const initialTickets = evt.max_attendees || (evt.available_tickets + 10);
        const sold = Math.max(0, initialTickets - evt.available_tickets);
        totalTicketsSold += sold;
        totalRevenue += (sold * Number(evt.price || 0));
      });
    }
  %>

  <!-- CREATOR STATS SUMMARY -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-8">
    
    <!-- Total Events Created -->
    <div class="bg-white rounded-3xl p-6 border border-accent/40 shadow-lg shadow-gray-200/40 flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center text-2xl border border-primary/20 shrink-0">
        <i class="bi bi-calendar-event"></i>
      </div>
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Events Published</span>
        <div class="text-2xl font-extrabold text-gray-900 tracking-tight"><%= totalEvents %></div>
      </div>
    </div>

    <!-- Total Tickets Sold -->
    <div class="bg-white rounded-3xl p-6 border border-accent/40 shadow-lg shadow-gray-200/40 flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl border border-emerald-200 shrink-0">
        <i class="bi bi-ticket-perforated font-bold"></i>
      </div>
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Total Tickets Sold</span>
        <div class="text-2xl font-extrabold text-gray-900 tracking-tight"><%= totalTicketsSold.toLocaleString('id-ID') %></div>
      </div>
    </div>

    <!-- Estimated Revenue -->
    <div class="bg-white rounded-3xl p-6 border border-accent/40 shadow-lg shadow-gray-200/40 flex items-center gap-4">
      <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl border border-amber-200 shrink-0">
        <i class="bi bi-wallet2"></i>
      </div>
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Estimated Sales</span>
        <div class="text-2xl font-extrabold text-primary tracking-tight">
          <%= totalRevenue === 0 ? 'Rp0' : ('Rp' + totalRevenue.toLocaleString('id-ID')) %>
        </div>
      </div>
    </div>

  </div>

  <!-- MY EVENTS LIST -->
  <div class="space-y-6">

    <% if (typeof events !== 'undefined' && events && events.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
      <% events.forEach(event => { %>
        <% 
          const categoryName = (event.Category && event.Category.name) ? event.Category.name : 'Event';
          const maxCapacity = event.max_attendees || (event.available_tickets + 20);
          const ticketsAvailable = event.available_tickets || 0;
          const ticketsSold = Math.max(0, maxCapacity - ticketsAvailable);
          const percentSold = maxCapacity > 0 ? Math.min(100, Math.round((ticketsSold / maxCapacity) * 100)) : 0;
          const isPublished = (event.is_published !== false);
        %>

        <!-- EVENT CARD ITEM -->
        <div class="bg-white rounded-3xl overflow-hidden border border-accent/40 shadow-lg shadow-gray-200/40 hover:shadow-xl transition-all duration-300 flex flex-col group">
          
          <!-- Card Banner Image & Status -->
          <div class="relative h-48 w-full bg-gray-100 overflow-hidden">
            <img src="<%= event.image_path || '/images/placeholder.jpg' %>" alt="<%= event.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            
            <div class="absolute top-3 left-3 flex items-center gap-2">
              <span class="px-3 py-1 bg-black/60 backdrop-blur-md text-white text-[10px] font-extrabold uppercase rounded-xl">
                <%= categoryName %>
              </span>
            </div>

            <div class="absolute top-3 right-3">
              <% if (isPublished) { %>
                <span class="px-3 py-1 bg-emerald-500/90 backdrop-blur-md text-white text-[10px] font-extrabold uppercase rounded-full shadow-sm flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                  Active
                </span>
              <% } else { %>
                <span class="px-3 py-1 bg-gray-600/90 backdrop-blur-md text-white text-[10px] font-extrabold uppercase rounded-full shadow-sm">
                  Draft
                </span>
              <% } %>
            </div>
          </div>

          <!-- Card Body Details -->
          <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <h3 class="text-lg font-extrabold text-gray-900 line-clamp-2 leading-snug group-hover:text-primary transition-colors">
                <a href="/events/<%= event.id %>">
                  <%= event.title %>
                </a>
              </h3>

              <!-- Schedule & Venue -->
              <div class="space-y-1 text-xs text-gray-600 font-medium">
                <p class="flex items-center gap-2">
                  <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span><%= event.event_date ? new Date(event.event_date).toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) : 'TBA' %></span>
                </p>
                <p class="flex items-center gap-2 truncate">
                  <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span class="truncate"><%= event.venue || 'Venue' %>, <strong><%= event.city || 'Indonesia' %></strong></span>
                </p>
              </div>
            </div>

            <!-- Ticket Progress & Pricing -->
            <div class="pt-3 border-t border-gray-100 space-y-3">
              
              <!-- Ticket Sales Bar -->
              <div class="space-y-1">
                <div class="flex items-center justify-between text-xs font-bold text-gray-700">
                  <span>Tickets Sold</span>
                  <span><%= ticketsSold %> / <%= maxCapacity %> (<%= percentSold %>%)</span>
                </div>
                <div class="w-full h-2 rounded-full bg-gray-100 overflow-hidden">
                  <div class="h-full bg-primary rounded-full transition-all duration-500" style="width: <%= percentSold %>%;"></div>
                </div>
              </div>

              <!-- Price -->
              <div class="flex items-center justify-between pt-1">
                <span class="text-xs text-gray-400 font-bold uppercase">Price</span>
                <span class="text-base font-extrabold text-primary">
                  <%= Number(event.price || 0) === 0 ? 'Free' : ('Rp' + Number(event.price).toLocaleString('id-ID')) %>
                </span>
              </div>

            </div>

            <!-- Card Action Footer -->
            <div class="pt-3 border-t border-gray-100 flex items-center justify-between gap-2">
              <a href="/events/<%= event.id %>" class="flex-grow inline-flex items-center justify-center gap-1.5 text-xs font-bold text-gray-700 hover:text-primary bg-bg-base/70 hover:bg-bg-base px-4 py-2.5 rounded-2xl border border-gray-200 transition-colors">
                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <span>View Public Page</span>
              </a>
            </div>

          </div>

        </div>
      <% }); %>
    </div>
    <% } else { %>
    <!-- EMPTY STATE WHEN CREATOR HAS NOT PUBLISHED ANY EVENTS -->
    <div class="text-center py-16 px-4 bg-white rounded-3xl border border-accent/40 shadow-lg shadow-gray-200/40 space-y-4">
      <div class="w-16 h-16 rounded-3xl bg-primary/10 text-primary mx-auto flex items-center justify-center border border-primary/20 shadow-inner">
        <i class="bi bi-calendar-plus text-3xl"></i>
      </div>
      <div class="space-y-1">
        <h3 class="text-xl font-extrabold text-gray-900">No Events Published Yet</h3>
        <p class="text-gray-500 text-sm max-w-md mx-auto leading-relaxed">
          You haven't created any events. Start hosting your workshops, concerts, or conferences on EventHub today!
        </p>
      </div>
      <a href="/events/create" class="inline-flex items-center gap-2 px-6 py-3.5 bg-primary hover:bg-secondary text-white font-extrabold text-sm rounded-2xl shadow-md shadow-primary/20 hover:scale-105 transition-all duration-200">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Create First Event</span>
      </a>
    </div>
    <% } %>

  </div>

</main>
<!-- ==================== END MAIN MY EVENTS CONTAINER ==================== -->

<%- include('../../partials/footer'); %>
