<%- include('../../partials/header'); %>

<!-- ==================== MAIN CONTENT CONTAINER ==================== -->
<main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-7xl">

  <%- include('../../partials/alert'); %>

  <!-- BREADCRUMB & BACK BUTTON -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/events" class="hover:text-primary transition-colors">Events</a>
      <span>/</span>
      <span class="text-primary font-bold truncate max-w-[200px] sm:max-w-xs"><%= event.title %></span>
    </div>

    <a href="/events" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-primary bg-white hover:bg-bg-base px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all duration-200 self-start sm:self-auto hover:scale-[1.02]">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>Back to Events</span>
    </a>
  </div>

  <!-- 2-COLUMN MAIN CONTENT GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- LEFT COLUMN: MAIN EVENT DETAILS (8 COLS ON LG) -->
    <div class="lg:col-span-8 space-y-8">

      <!-- 1. EVENT POSTER HERO IMAGE -->
      <div class="relative w-full aspect-[16/9] rounded-3xl overflow-hidden shadow-xl shadow-gray-200/60 border border-gray-100 bg-gray-100">
        <img src="<%= event.image_path %>" alt="<%= event.title %>" class="w-full h-full object-cover" loading="eager" />
      </div>

      <!-- 2. COMBINED SINGLE EVENT INFO CARD -->
      <div class="bg-white rounded-3xl p-6 sm:p-8 border border-accent/40 shadow-lg shadow-gray-200/40 space-y-8">

        <!-- Header: Category & City Badges, Title, Organizer -->
        <div class="space-y-4 pb-6 border-b border-gray-100">
          <!-- Main Title -->
          <h1 class="text-2xl sm:text-4xl font-extrabold text-gray-900 leading-tight tracking-tight">
            <%= event.title %>
          </h1>

          <!-- Organizer Info Box with Name, Phone, Email -->
          <% 
            const organizerName = (event.User && event.User.name) ? event.User.name.toUpperCase() : (event.User.name.toUpperCase || 'Event Organizer'); 
            const organizerEmail = (event.User && event.User.email) ? event.User.email : null;
            const organizerPhone = (event.User && event.User.phone) ? event.User.phone : null;
          %>
          <div class="bg-bg-base/40 rounded-2xl p-4 sm:p-5 border border-gray-200/60 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary font-black text-xl border border-primary/20 flex items-center justify-center shadow-inner shrink-0">
                <%= organizerName.charAt(0).toUpperCase() %>
              </div>
              <div>
                <p class="text-[11px] text-gray-400 font-bold uppercase tracking-wider">Organized by</p>
                <h4 class="text-base font-bold text-gray-800 flex items-center gap-1.5">
                  <span><%= organizerName %></span>
                  <svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </h4>
              </div>
            </div>

            <!-- Organizer Contact Info (Email & Phone) -->
            <div class="flex flex-wrap items-center gap-4 text-xs font-semibold text-gray-600 border-t md:border-t-0 md:border-l border-gray-200/80 pt-3 md:pt-0 md:pl-5">
              <% if (organizerEmail) { %>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span><%= organizerEmail %></span>
              </div>
              <% } %>

              <% if (organizerPhone) { %>
              <div class="flex items-center gap-1.5">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span><%= organizerPhone %></span>
              </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Event Highlights Grid (Category, Ticket Price, Availability, Date/Time, Venue) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pb-6 border-b border-gray-100">

          <!-- 1. Category Box -->
          <div class="bg-bg-base/40 hover:bg-bg-base/70 transition-colors rounded-2xl p-5 border border-gray-200/60 flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-accent/60 text-primary flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
              </svg>
            </div>
            <div>
              <p class="text-[11px] text-gray-400 font-bold uppercase tracking-wider">Category</p>
              <h4 class="text-sm sm:text-base font-bold text-gray-800 mt-0.5">
                <%= (event.Category && event.Category.name) ? event.Category.name : 'Event' %>
              </h4>
              <p class="text-xs text-gray-500 mt-1 font-medium">Event Genre</p>
            </div>
          </div>

          <!-- 2. Ticket Price Box -->
          <div class="bg-bg-base/40 hover:bg-bg-base/70 transition-colors rounded-2xl p-5 border border-gray-200/60 flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-accent/60 text-primary flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 002 2 2 2 0 010 4 2 2 0 00-2 2v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 00-2-2 2 2 0 010-4 2 2 0 002-2V7a2 2 0 00-2-2H5z" />
              </svg>
            </div>
            <div>
              <p class="text-[11px] text-gray-400 font-bold uppercase tracking-wider">Ticket Price</p>
              <h4 class="text-sm sm:text-base font-bold text-gray-800 mt-0.5">
                <%= Number(event.price || 0) === 0 ? 'Free' : ('Rp' + Number(event.price).toLocaleString('id-ID')) %>
              </h4>
              <p class="text-xs text-gray-500 mt-1 font-medium">Per Ticket</p>
            </div>
          </div>

          <!-- 3. Ticket Availability Box (available_tickets / max_attendees) -->
          <div class="bg-bg-base/40 hover:bg-bg-base/70 transition-colors rounded-2xl p-5 border border-gray-200/60 flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-accent/60 text-primary flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <div>
              <p class="text-[11px] text-gray-400 font-bold uppercase tracking-wider">Tickets Available</p>
              <h4 class="text-sm sm:text-base font-bold text-gray-800 mt-0.5">
                <span class="text-primary"><%= event.available_tickets %></span> / <%= event.max_attendees %> Seats
              </h4>
              <p class="text-xs text-gray-500 mt-1 font-medium">
                <%= (event.available_tickets > 0) ? (event.available_tickets + ' tickets remaining') : 'Sold Out' %>
              </p>
            </div>
          </div>

          <!-- 4. Date & Time Box -->
          <div class="bg-bg-base/40 hover:bg-bg-base/70 transition-colors rounded-2xl p-5 border border-gray-200/60 flex items-start gap-4 sm:col-span-2 lg:col-span-2">
            <div class="w-11 h-11 rounded-2xl bg-accent/60 text-primary flex items-center justify-center shrink-0 shadow-inner mt-0.5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="space-y-1.5 flex-grow">
              <p class="text-[11px] text-gray-400 font-bold uppercase tracking-wider">Date & Time Schedule</p>

              <!-- Start Date & Time -->
              <div class="text-xs sm:text-sm text-gray-800 flex items-center gap-1.5 flex-wrap">
                <span class="font-bold text-primary">Start:</span>
                <span class="font-semibold">
                  <%= event.event_date ? new Date(event.event_date).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) : 'TBA' %>
                </span>
                <span class="text-gray-400">•</span>
                <span class="font-medium text-gray-600">
                  <%= event.event_date ? new Date(event.event_date).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) : '00:00' %> WIB
                </span>
              </div>

              <!-- End Date & Time -->
              <% if (event.event_end_date) { %>
              <div class="text-xs sm:text-sm text-gray-800 flex items-center gap-1.5 flex-wrap border-t border-gray-200/60 pt-1.5">
                <span class="font-bold text-secondary">End:</span>
                <span class="font-semibold">
                  <%= new Date(event.event_end_date).toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }) %>
                </span>
                <span class="text-gray-400">•</span>
                <span class="font-medium text-gray-600">
                  <%= new Date(event.event_end_date).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB
                </span>
              </div>
              <% } %>
            </div>
          </div>

          <!-- 5. Venue Box -->
          <div class="bg-bg-base/40 hover:bg-bg-base/70 transition-colors rounded-2xl p-5 border border-gray-200/60 flex items-start gap-4">
            <div class="w-11 h-11 rounded-2xl bg-accent/60 text-primary flex items-center justify-center shrink-0 shadow-inner">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <p class="text-[11px] text-gray-400 font-bold uppercase tracking-wider">Location & Venue</p>
              <h4 class="text-sm sm:text-base font-bold text-gray-800 mt-0.5">
                <%= event.venue || 'Venue TBA' %>
              </h4>
              <p class="text-xs text-gray-500 mt-1 font-medium">
                <%= event.city || 'Indonesia' %>
              </p>
            </div>
          </div>

        </div>

        <!-- Description Section Inside Card -->
        <div class="space-y-4">
          <h3 class="text-xl font-bold text-gray-900 flex items-center gap-2">
            <span class="w-2.5 h-6 bg-primary rounded-full inline-block"></span>
            About This Event
          </h3>
          <div class="text-gray-600 text-base leading-relaxed space-y-3 font-normal">
            <% if (event.description) { %>
            <% event.description.split('\n').forEach(paragraph => { %>
            <% if (paragraph.trim()) { %>
            <p><%= paragraph %></p>
            <% } %>
            <% }); %>
            <% } else { %>
            <p class="text-gray-400 italic">No description available for this event.</p>
            <% } %>
          </div>
        </div>

      </div>

    </div>

    <!-- RIGHT COLUMN: BUY TICKET SIDEBAR CARD (4 COLS ON LG - STICKY) -->
    <div class="lg:col-span-4 lg:sticky lg:top-24 space-y-6">

      <div class="bg-white rounded-3xl p-6 sm:p-7 border border-accent/60 shadow-xl shadow-gray-200/50 space-y-6">

        <!-- Sidebar Header / Ticket Price -->
        <div class="border-b border-gray-100 pb-5">
          <span class="text-xs font-bold uppercase tracking-wider text-gray-400">Ticket Price</span>
          <div class="flex items-baseline gap-1 mt-1">
            <% const ticketPrice = Number(event.price || 0); %>
            <span class="text-3xl font-extrabold text-gray-900 tracking-tight">
              <%= ticketPrice === 0 ? 'Free' : ('Rp' + ticketPrice.toLocaleString('id-ID')) %>
            </span>
            <% if (ticketPrice > 0) { %>
            <span class="text-xs font-semibold text-gray-400">/ ticket</span>
            <% } %>
          </div>
        </div>

        <!-- Ticket Availability Progress & Status -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs font-bold">
            <span class="text-gray-500 uppercase tracking-wider">Availability</span>
            <% const avail = event.available_tickets || 0; %>
            <% const total = event.max_attendees || 100; %>
            <% const isSoldOut = avail <= 0; %>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold <%= isSoldOut ? 'bg-red-50 text-red-600 border border-red-100' : 'bg-emerald-50 text-emerald-600 border border-emerald-100' %>">
              <%= isSoldOut ? 'Sold Out' : (avail + ' tickets left') %>
            </span>
          </div>

          <!-- Progress Bar -->
          <% const pct = total > 0 ? Math.min(100, Math.max(0, Math.round(((total - avail) / total) * 100))) : 0; %>
          <div class="w-full h-2.5 bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full bg-primary rounded-full transition-all duration-500" style="width: <%= pct %>%;"></div>
          </div>
          <p class="text-[11px] text-gray-400 text-right"><%= pct %>% booked (<%= total - avail %> of <%= total %> seats)</p>
        </div>

        <% if (typeof user !== 'undefined' && user) { %>
        <!-- BUY TICKET ACTION (LOGGED IN USER) -->
        <% if (!isSoldOut) { %>
        <a href="/events/<%= event.id %>/checkout" class="w-full bg-primary hover:bg-secondary text-white font-extrabold text-base py-4 rounded-2xl shadow-lg shadow-primary/25 hover:shadow-xl hover:shadow-primary/35 transition-all duration-300 transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span>Buy Ticket Now</span>
        </a>
        <% } else { %>
        <button type="button" disabled class="w-full bg-gray-200 text-gray-400 font-extrabold text-base py-4 rounded-2xl cursor-not-allowed flex items-center justify-center gap-2">
          <span>Event Sold Out</span>
        </button>
        <% } %>

        <% } else { %>
        <!-- LOGIN REQUIREMENT PROMPT & BUTTONS (GUEST USER) -->
        <div class="space-y-4 pt-2 border-t border-gray-100">
          <div class="bg-primary/5 rounded-2xl p-4 border border-primary/20 text-center space-y-1.5">
            <div class="w-10 h-10 rounded-full bg-primary/10 text-primary mx-auto flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h4 class="text-sm font-bold text-gray-800">Login Required</h4>
            <p class="text-xs text-gray-500 leading-relaxed">
              You need to log in to your account to purchase tickets for this event.
            </p>
          </div>

          <!-- Login & Register Action Buttons -->
          <div class="grid grid-cols-2 gap-3">
            <a href="/login" class="inline-flex items-center justify-center gap-2 bg-primary hover:bg-secondary text-white font-bold text-sm py-3.5 px-4 rounded-2xl shadow-md shadow-primary/20 hover:shadow-lg transition-all duration-200 text-center hover:scale-[1.02]">
              <span>Login</span>
            </a>
            <a href="/register" class="inline-flex items-center justify-center gap-2 bg-white hover:bg-bg-base text-gray-700 font-bold text-sm py-3.5 px-4 rounded-2xl border border-gray-200 hover:border-gray-300 transition-all duration-200 text-center shadow-sm hover:scale-[1.02]">
              <span>Register</span>
            </a>
          </div>
        </div>
        <% } %>

        <!-- Guarantee Note -->
        <div class="pt-2 flex items-center justify-center gap-2 text-xs text-gray-400 font-medium border-t border-gray-100">
          <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Instant e-Ticket Delivery & Safe Payment</span>
        </div>

      </div>

    </div>

  </div>

</main>
<!-- ==================== END MAIN CONTENT ==================== -->

<%- include('../../partials/footer'); %>