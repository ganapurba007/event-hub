<%- include('../../partials/header'); %>

<!-- ==================== MAIN CREATE EVENT CONTAINER ==================== -->
<main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-8 max-w-5xl">

  <!-- PAGE HEADER & BREADCRUMB -->
  <div class="mb-8">
    <div class="flex items-center gap-2 text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>/</span>
      <a href="/events" class="hover:text-primary transition-colors">Events</a>
      <span>/</span>
      <span class="text-primary font-bold">Create Event</span>
    </div>
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight flex items-center gap-3">
          <span class="w-3.5 h-9 bg-primary rounded-full inline-block"></span>
          Create New Event
        </h1>
        <p class="text-gray-500 text-sm sm:text-base mt-1">Fill in the details below to publish your event on EventHub</p>
      </div>
      <a href="/events" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-primary bg-white hover:bg-gray-50 px-4 py-2.5 rounded-2xl border border-gray-200 shadow-sm transition-all self-start sm:self-auto">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>Back to Events</span>
      </a>
    </div>
  </div>

  <!-- ERROR ALERT (If any) -->
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <div class="mb-8 p-4 bg-red-50 border-2 border-red-200 rounded-2xl text-red-700 space-y-1 shadow-sm">
    <div class="flex items-center gap-2 font-bold text-sm">
      <svg class="w-5 h-5 text-red-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span>Please fix the following errors:</span>
    </div>
    <ul class="list-disc list-inside text-xs pl-7 space-y-0.5">
      <% error.forEach(err => { %>
        <li><%= err %></li>
      <% }); %>
    </ul>
  </div>
  <% } %>

  <!-- CREATE EVENT FORM -->
  <form action="/events/create" method="POST" enctype="multipart/form-data" id="create-event-form" class="space-y-8">

    <!-- SECTION 1: BASIC INFORMATION -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-accent/40 shadow-lg shadow-gray-200/40 space-y-6">
      <div class="border-b border-gray-100 pb-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-bold text-lg border border-primary/20 shrink-0">
          <i class="bi bi-info-circle"></i>
        </div>
        <div>
          <h2 class="text-xl font-extrabold text-gray-900">Basic Event Information</h2>
          <p class="text-xs text-gray-500">Provide title, category, and detailed description of your event</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Judul Event -->
        <div class="md:col-span-2 space-y-2">
          <label for="title" class="block text-sm font-bold text-gray-700">
            Event Title <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
              <i class="bi bi-type-h1"></i>
            </div>
            <input type="text" name="title" id="title" required value="<%= typeof formData !== 'undefined' && formData.title ? formData.title : '' %>" placeholder="e.g., Indonesia Tech Summit 2026" class="w-full pl-10 pr-4 py-3 bg-bg-base/40 border border-gray-200 rounded-2xl text-sm font-medium focus:ring-2 focus:ring-primary focus:border-primary focus:bg-white transition-all outline-none" />
          </div>
        </div>

        <!-- Dropdown Kategori -->
        <div class="space-y-2">
          <label for="category_id" class="block text-sm font-bold text-gray-700">
            Category <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <select name="category_id" id="category_id" required class="select2-category w-full bg-bg-base/40 border border-gray-200 rounded-2xl text-sm font-medium focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none">
              <option value="">Select Category</option>
              <% if (typeof categories !== 'undefined' && categories) { %>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>" <%= (typeof formData !== 'undefined' && String(formData.category_id) === String(cat.id)) ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }); %>
              <% } %>
            </select>
          </div>
        </div>

        <!-- Deskripsi Event -->
        <div class="md:col-span-3 space-y-2">
          <label for="description" class="block text-sm font-bold text-gray-700">
            Event Description <span class="text-red-500">*</span>
          </label>
          <textarea name="description" id="description" rows="5" required placeholder="Describe what makes your event special, key speakers, schedule highlights, agenda, and target audience..." class="w-full p-4 bg-bg-base/40 border border-gray-200 rounded-2xl text-sm font-medium focus:ring-2 focus:ring-primary focus:border-primary focus:bg-white transition-all outline-none resize-y"><%= typeof formData !== 'undefined' && formData.description ? formData.description : '' %></textarea>
          <p class="text-[11px] text-gray-400 text-right">Markdown supported</p>
        </div>

      </div>
    </div>

    <!-- SECTION 2: DATE, TIME & LOCATION -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-accent/40 shadow-lg shadow-gray-200/40 space-y-6">
      <div class="border-b border-gray-100 pb-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-bold text-lg border border-primary/20 shrink-0">
          <i class="bi bi-geo-alt"></i>
        </div>
        <div>
          <h2 class="text-xl font-extrabold text-gray-900">Date, Time & Venue</h2>
          <p class="text-xs text-gray-500">Set event start/end schedule and location details</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Tanggal dan Waktu Mulai -->
        <div class="space-y-2">
          <label for="event_date" class="block text-sm font-bold text-gray-700">
            Start Date & Time <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <input type="datetime-local" name="event_date" id="event_date" required value="<%= typeof formData !== 'undefined' && formData.event_date ? formData.event_date : '' %>" class="w-full px-4 py-3 bg-bg-base/40 border border-gray-200 rounded-2xl text-sm font-medium focus:ring-2 focus:ring-primary focus:border-primary focus:bg-white transition-all outline-none" />
          </div>
        </div>

        <!-- Tanggal dan Waktu Selesai -->
        <div class="space-y-2">
          <label for="event_end_date" class="block text-sm font-bold text-gray-700">
            End Date & Time <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <input type="datetime-local" name="event_end_date" id="event_end_date" required value="<%= typeof formData !== 'undefined' && formData.event_end_date ? formData.event_end_date : '' %>" class="w-full px-4 py-3 bg-bg-base/40 border border-gray-200 rounded-2xl text-sm font-medium focus:ring-2 focus:ring-primary focus:border-primary focus:bg-white transition-all outline-none" />
          </div>
        </div>

        <!-- Lokasi Venue -->
        <div class="space-y-2">
          <label for="venue" class="block text-sm font-bold text-gray-700">
            Venue / Building Name <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
              <i class="bi bi-building"></i>
            </div>
            <input type="text" name="venue" id="venue" required value="<%= typeof formData !== 'undefined' && formData.venue ? formData.venue : '' %>" placeholder="e.g., Jakarta Convention Center (JCC) Hall B" class="w-full pl-10 pr-4 py-3 bg-bg-base/40 border border-gray-200 rounded-2xl text-sm font-medium focus:ring-2 focus:ring-primary focus:border-primary focus:bg-white transition-all outline-none" />
          </div>
        </div>

        <!-- Dropdown Kota -->
        <div class="space-y-2">
          <label for="city" class="block text-sm font-bold text-gray-700">
            City <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <select name="city" id="city" required class="select2-city w-full bg-bg-base/40 border border-gray-200 rounded-2xl text-sm font-medium focus:ring-2 focus:ring-primary focus:border-primary transition-all outline-none">
              <option value="">Select City</option>
              <% 
                const availableCities = ['Jakarta', 'Bandung', 'Surabaya', 'Yogyakarta', 'Bali', 'Medan', 'Semarang', 'Makassar', 'Tangerang', 'Bogor', 'Bekasi', 'Depok', 'Malang', 'Solo', 'Palembang', 'Balikpapan'];
                const selectedCity = (typeof formData !== 'undefined' && formData.city) ? formData.city : '';
              %>
              <% availableCities.forEach(c => { %>
                <option value="<%= c %>" <%= selectedCity === c ? 'selected' : '' %>><%= c %></option>
              <% }); %>
            </select>
          </div>
        </div>

      </div>
    </div>

    <!-- SECTION 3: TICKETS & CAPACITY -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-accent/40 shadow-lg shadow-gray-200/40 space-y-6">
      <div class="border-b border-gray-100 pb-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-bold text-lg border border-primary/20 shrink-0">
          <i class="bi bi-ticket-perforated"></i>
        </div>
        <div>
          <h2 class="text-xl font-extrabold text-gray-900">Tickets & Pricing</h2>
          <p class="text-xs text-gray-500">Configure ticket pricing, available quantity, and maximum venue capacity</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <!-- Harga Tiket -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label for="price" class="block text-sm font-bold text-gray-700">
              Ticket Price (IDR) <span class="text-red-500">*</span>
            </label>
            <button type="button" onclick="setFreePrice()" class="text-[11px] text-primary hover:underline font-bold">
              Set as Free
            </button>
          </div>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-500 font-bold text-xs">
              Rp
            </div>
            <input type="number" name="price" id="price" min="0" step="1000" required value="<%= typeof formData !== 'undefined' && typeof formData.price !== 'undefined' ? formData.price : '0' %>" placeholder="0" class="w-full pl-10 pr-4 py-3 bg-bg-base/40 border border-gray-200 rounded-2xl text-sm font-semibold focus:ring-2 focus:ring-primary focus:border-primary focus:bg-white transition-all outline-none" />
          </div>
          <p class="text-[11px] text-gray-400">Enter 0 for Free admission</p>
        </div>

        <!-- Jumlah Tiket -->
        <div class="space-y-2">
          <label for="available_tickets" class="block text-sm font-bold text-gray-700">
            Available Tickets <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
              <i class="bi bi-ticket-detailed"></i>
            </div>
            <input type="number" name="available_tickets" id="available_tickets" min="1" required value="<%= typeof formData !== 'undefined' && formData.available_tickets ? formData.available_tickets : '100' %>" placeholder="e.g. 100" class="w-full pl-10 pr-4 py-3 bg-bg-base/40 border border-gray-200 rounded-2xl text-sm font-medium focus:ring-2 focus:ring-primary focus:border-primary focus:bg-white transition-all outline-none" />
          </div>
        </div>

        <!-- Kapasitas Maksimal -->
        <div class="space-y-2">
          <label for="max_attendees" class="block text-sm font-bold text-gray-700">
            Max Capacity <span class="text-red-500">*</span>
          </label>
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
              <i class="bi bi-people"></i>
            </div>
            <input type="number" name="max_attendees" id="max_attendees" min="1" required value="<%= typeof formData !== 'undefined' && formData.max_attendees ? formData.max_attendees : '500' %>" placeholder="e.g. 500" class="w-full pl-10 pr-4 py-3 bg-bg-base/40 border border-gray-200 rounded-2xl text-sm font-medium focus:ring-2 focus:ring-primary focus:border-primary focus:bg-white transition-all outline-none" />
          </div>
        </div>

      </div>
    </div>

    <!-- SECTION 4: EVENT IMAGE UPLOAD -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-accent/40 shadow-lg shadow-gray-200/40 space-y-6">
      <div class="border-b border-gray-100 pb-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary flex items-center justify-center font-bold text-lg border border-primary/20 shrink-0">
          <i class="bi bi-image"></i>
        </div>
        <div>
          <h2 class="text-xl font-extrabold text-gray-900">Event Poster / Cover Image</h2>
          <p class="text-xs text-gray-500">Upload a high-quality banner poster or provide an image URL</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">

        <!-- Drag and Drop Upload Box -->
        <div class="space-y-3">
          <label class="block text-sm font-bold text-gray-700">
            Upload Image File
          </label>
          <div id="drop-zone" class="border-2 border-dashed border-gray-300 hover:border-primary rounded-3xl p-6 text-center bg-bg-base/30 hover:bg-primary/5 transition-all duration-200 cursor-pointer relative group">
            <input type="file" name="image" id="image-upload" accept="image/*" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" onchange="previewUploadedImage(this)" />
            <div class="space-y-2 pointer-events-none">
              <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary mx-auto flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                <i class="bi bi-cloud-arrow-up"></i>
              </div>
              <p class="text-sm font-bold text-gray-700">Click to upload or drag & drop</p>
              <p class="text-xs text-gray-400">PNG, JPG, WEBP up to 5MB</p>
            </div>
          </div>

          <!-- Fallback Image URL Input -->
          <div class="pt-2">
            <span class="text-xs text-gray-400 font-bold uppercase tracking-wider block mb-1">Or Provide Image URL</span>
            <div class="relative">
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                <i class="bi bi-link-45deg"></i>
              </div>
              <input type="url" name="image_path" id="image_url" placeholder="https://example.com/poster.jpg" value="<%= typeof formData !== 'undefined' && formData.image_path ? formData.image_path : '' %>" oninput="previewUrlImage(this.value)" class="w-full pl-10 pr-4 py-2.5 bg-bg-base/40 border border-gray-200 rounded-2xl text-xs font-medium focus:ring-2 focus:ring-primary focus:border-primary focus:bg-white transition-all outline-none" />
            </div>
          </div>
        </div>

        <!-- Live Preview Container -->
        <div class="space-y-2">
          <label class="block text-sm font-bold text-gray-700">
            Image Preview
          </label>
          <div class="w-full h-64 rounded-3xl overflow-hidden bg-gray-100 border border-gray-200 shadow-inner flex items-center justify-center relative group">
            <img id="image-preview" src="/images/placeholder.jpg" alt="Preview" class="w-full h-full object-cover hidden" />
            <div id="preview-placeholder" class="text-center p-6 text-gray-400 space-y-2">
              <i class="bi bi-card-image text-4xl block"></i>
              <p class="text-xs font-semibold">Image preview will appear here</p>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- PUBLISH & ACTION BUTTONS -->
    <div class="flex items-center justify-end gap-4 pt-4 pb-12">
      <a href="/events" class="px-6 py-3.5 rounded-2xl bg-white hover:bg-gray-100 text-gray-700 font-bold text-sm border border-gray-200 shadow-sm transition-all">
        Cancel
      </a>
      <button type="submit" class="px-8 py-3.5 rounded-2xl bg-primary hover:bg-secondary text-white font-extrabold text-sm shadow-xl shadow-primary/25 hover:shadow-2xl hover:scale-[1.02] transition-all flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span>Publish Event</span>
      </button>
    </div>

  </form>

</main>
<!-- ==================== END MAIN CREATE EVENT CONTAINER ==================== -->

<!-- PAGE SCRIPTS -->
<script>
  $(document.body).ready(function() {
    // Initialize Select2 on category and city dropdowns
    $('.select2-category').select2({
      placeholder: 'Select Category',
      allowClear: true,
      width: '100%'
    });

    $('.select2-city').select2({
      placeholder: 'Select City',
      allowClear: true,
      width: '100%'
    });
  });

  function setFreePrice() {
    const priceInput = document.getElementById('price');
    if (priceInput) {
      priceInput.value = '0';
    }
  }

  function previewUploadedImage(input) {
    const preview = document.getElementById('image-preview');
    const placeholder = document.getElementById('preview-placeholder');

    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        preview.src = e.target.result;
        preview.classList.remove('hidden');
        if (placeholder) placeholder.classList.add('hidden');
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  function previewUrlImage(url) {
    const preview = document.getElementById('image-preview');
    const placeholder = document.getElementById('preview-placeholder');
    const fileInput = document.getElementById('image-upload');

    // Only set URL preview if no local file is chosen
    if (url && (!fileInput.files || fileInput.files.length === 0)) {
      preview.src = url;
      preview.classList.remove('hidden');
      if (placeholder) placeholder.classList.add('hidden');
    }
  }
</script>

<%- include('../../partials/footer'); %>
