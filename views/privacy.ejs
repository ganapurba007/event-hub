<%- include('../partials/header'); %>

<!-- ==================== MAIN CONTENT CONTAINER ==================== -->
<main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-10 max-w-7xl">

  <!-- BREADCRUMB & PAGE HERO HEADER -->
  <div class="mb-10 text-center sm:text-left space-y-4">
    <!-- Breadcrumb -->
    <div class="flex items-center justify-center sm:justify-start gap-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-primary font-bold">Privacy Policy</span>
    </div>

    <!-- Hero Card Header -->
    <div class="bg-gradient-to-r from-primary/10 via-accent/30 to-bg-base/60 rounded-3xl p-6 sm:p-10 border border-primary/15 shadow-sm relative overflow-hidden">
      <div class="max-w-3xl relative z-10 space-y-3">
        <div class="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm px-3.5 py-1.5 rounded-full border border-primary/20 text-primary text-xs font-bold shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <span>Privacy & Trust Protection</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
          Privacy Policy
        </h1>

        <p class="text-gray-600 text-base sm:text-lg leading-relaxed font-normal">
          At EventHub, we value your trust. This Privacy Policy outlines how we collect, use, store, and safeguard your personal information when you use our platform.
        </p>

        <div class="flex items-center gap-4 pt-2 text-xs font-semibold text-gray-500">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Last Updated: September 2026
          </span>
          <span>•</span>
          <span>Version 1.2</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 2-COLUMN CONTENT GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- LEFT SIDEBAR: STICKY NAVIGATION (4 COLS ON LG) -->
    <div class="lg:col-span-4 lg:sticky lg:top-24 space-y-6 hidden lg:block">
      <div class="bg-white rounded-3xl p-6 border border-accent/50 shadow-lg shadow-gray-200/40 space-y-4">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-gray-400">On This Page</h3>
        <nav class="space-y-1">
          <a href="#collect" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">1</span>
            <span>Information We Collect</span>
          </a>
          <a href="#usage" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">2</span>
            <span>How We Use Information</span>
          </a>
          <a href="#sharing" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">3</span>
            <span>Information Sharing</span>
          </a>
          <a href="#security" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">4</span>
            <span>Data Security</span>
          </a>
          <a href="#cookies" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">5</span>
            <span>Cookies & Tracking</span>
          </a>
          <a href="#rights" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">6</span>
            <span>Your Privacy Rights</span>
          </a>
          <a href="#contact" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">7</span>
            <span>Contact Us</span>
          </a>
        </nav>
      </div>

      <!-- Quick Need Help Card -->
      <div class="bg-primary/5 rounded-3xl p-6 border border-primary/20 space-y-3">
        <h4 class="text-sm font-bold text-gray-900 flex items-center gap-2">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Have Questions?</span>
        </h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          If you have any questions or concerns regarding our privacy practices, our dedicated Data Protection Officer is here to assist you.
        </p>
        <a href="mailto:privacy@eventhub.com" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:underline">
          <span>Email Privacy Team &rarr;</span>
        </a>
      </div>
    </div>

    <!-- RIGHT COLUMN: PRIVACY POLICY SECTIONS (8 COLS ON LG) -->
    <div class="lg:col-span-8 space-y-8">
      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-accent/40 shadow-lg shadow-gray-200/40 space-y-10 text-gray-700 leading-relaxed">

        <!-- SECTION 1: INFORMATION WE COLLECT -->
        <section id="collect" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              1
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Information We Collect
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            We collect personal information that you voluntarily provide to us when registering an account, purchasing event tickets, creating an event listing, or communicating with us.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="bg-bg-base/40 rounded-2xl p-4 border border-gray-200/60 space-y-2">
              <h4 class="text-sm font-bold text-gray-900 flex items-center gap-2">
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                Personal Credentials
              </h4>
              <p class="text-xs text-gray-500 leading-relaxed">
                Full name, email address, phone number, password hash, and account role (creator or attendee).
              </p>
            </div>

            <div class="bg-bg-base/40 rounded-2xl p-4 border border-gray-200/60 space-y-2">
              <h4 class="text-sm font-bold text-gray-900 flex items-center gap-2">
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 002 2 2 2 0 010 4 2 2 0 00-2 2v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 00-2-2 2 2 0 010-4 2 2 0 002-2V7a2 2 0 00-2-2H5z" />
                </svg>
                Transaction & Order Data
              </h4>
              <p class="text-xs text-gray-500 leading-relaxed">
                Ticket quantities, total transaction amounts, purchase timestamps, and event booking history.
              </p>
            </div>
          </div>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 2: HOW WE USE INFORMATION -->
        <section id="usage" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              2
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              How We Use Information
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            Your information is strictly used to deliver seamless event discovery and secure ticketing services. Key purposes include:
          </p>

          <ul class="space-y-3 text-sm text-gray-600 font-normal">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Order Processing & E-Tickets:</strong> Issuing digital ticket confirmations and verifying attendance at event venues.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Account Authentication:</strong> Ensuring secure login sessions and protecting creator profiles.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Customer Support & Notifications:</strong> Sending critical event updates, venue changes, or ticket confirmation emails.</span>
            </li>
          </ul>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 3: INFORMATION SHARING -->
        <section id="sharing" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              3
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Information Sharing & Disclosure
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            We respect your data privacy and <strong>never sell or rent your personal information</strong> to third-party marketers. Information is shared only under the following limited circumstances:
          </p>

          <div class="bg-amber-50/80 rounded-2xl p-4 sm:p-5 border border-amber-200/80 space-y-2 text-xs sm:text-sm text-amber-900">
            <h4 class="font-bold flex items-center gap-2">
              <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>With Event Organizers</span>
            </h4>
            <p class="leading-relaxed">
              When you purchase a ticket for an event, necessary attendee information (e.g., your name and ticket ID) is shared with the verified event organizer for check-in and security purposes.
            </p>
          </div>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 4: DATA SECURITY -->
        <section id="security" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              4
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Data Security & Storage
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            EventHub employs industry-standard encryption protocols (SSL/TLS) to protect data transmitted between your browser and our servers. User passwords are securely hashed using bcrypt prior to database storage.
          </p>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 5: COOKIES & TRACKING -->
        <section id="cookies" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              5
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Cookies & Tracking Technologies
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            We use essential HTTP cookies and session storage to keep you logged in and preserve your filter preferences across browsing sessions.
          </p>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 6: YOUR PRIVACY RIGHTS -->
        <section id="rights" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              6
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Your Privacy Rights & Choices
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            You have full control over your personal information on EventHub:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm font-semibold">
            <div class="p-3.5 bg-bg-base/50 rounded-xl border border-gray-200/80 flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-primary"></span>
              <span>Access & Export Your Profile Data</span>
            </div>
            <div class="p-3.5 bg-bg-base/50 rounded-xl border border-gray-200/80 flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-primary"></span>
              <span>Update or Correct Account Details</span>
            </div>
            <div class="p-3.5 bg-bg-base/50 rounded-xl border border-gray-200/80 flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-primary"></span>
              <span>Opt-Out of Marketing Communications</span>
            </div>
            <div class="p-3.5 bg-bg-base/50 rounded-xl border border-gray-200/80 flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-primary"></span>
              <span>Request Account Deletion & Data Removal</span>
            </div>
          </div>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 7: CONTACT US -->
        <section id="contact" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              7
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Contact Privacy Team
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            If you have questions about this policy or wish to exercise your data rights, please get in touch with our team:
          </p>

          <div class="bg-primary/5 rounded-2xl p-5 border border-primary/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h4 class="text-base font-bold text-gray-900">EventHub Data Privacy Office</h4>
              <p class="text-xs text-gray-500 mt-0.5">Yogyakarta, Indonesia</p>
            </div>
            <a href="mailto:privacy@eventhub.com" class="inline-flex items-center gap-2 bg-primary hover:bg-secondary text-white font-bold text-xs py-3 px-5 rounded-xl shadow-md shadow-primary/20 transition-all self-start sm:self-auto">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Email privacy@eventhub.com</span>
            </a>
          </div>
        </section>

      </div>
    </div>

  </div>

</main>
<!-- ==================== END MAIN CONTENT ==================== -->

<%- include('../partials/footer'); %>