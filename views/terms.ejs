<%- include('../partials/header'); %>

<!-- ==================== MAIN CONTENT CONTAINER ==================== -->
<main class="flex-grow container mx-auto px-4 sm:px-6 lg:px-8 py-10 max-w-7xl">

  <!-- BREADCRUMB & PAGE HERO HEADER -->
  <div class="mb-10 text-center sm:text-left space-y-4">
    <!-- Breadcrumb -->
    <div class="flex items-center justify-center sm:justify-start gap-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
      <a href="/" class="hover:text-primary transition-colors">Home</a>
      <span>/</span>
      <span class="text-primary font-bold">Terms of Service</span>
    </div>

    <!-- Hero Card Header -->
    <div class="bg-gradient-to-r from-primary/10 via-accent/30 to-bg-base/60 rounded-3xl p-6 sm:p-10 border border-primary/15 shadow-sm relative overflow-hidden">
      <div class="max-w-3xl relative z-10 space-y-3">
        <div class="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm px-3.5 py-1.5 rounded-full border border-primary/20 text-primary text-xs font-bold shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Legal Agreement & User Guidelines</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
          Terms of Service
        </h1>

        <p class="text-gray-600 text-base sm:text-lg leading-relaxed font-normal">
          Please read these Terms of Service carefully before accessing or using EventHub. By creating an account or purchasing tickets, you agree to be bound by these terms.
        </p>

        <div class="flex items-center gap-4 pt-2 text-xs font-semibold text-gray-500">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Last Updated: September 2026
          </span>
          <span>•</span>
          <span>Version 1.1</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 2-COLUMN CONTENT GRID -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

    <!-- LEFT SIDEBAR: STICKY NAVIGATION (4 COLS ON LG) -->
    <div class="lg:col-span-4 lg:sticky lg:top-24 space-y-6 hidden lg:block">
      <div class="bg-white rounded-3xl p-6 border border-accent/50 shadow-lg shadow-gray-200/40 space-y-4">
        <h3 class="text-xs font-extrabold uppercase tracking-wider text-gray-400">Sections</h3>
        <nav class="space-y-1">
          <a href="#acceptance" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">1</span>
            <span>Acceptance of Terms</span>
          </a>
          <a href="#accounts" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">2</span>
            <span>Account & User Roles</span>
          </a>
          <a href="#organizers" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">3</span>
            <span>Event Creation & Rules</span>
          </a>
          <a href="#tickets" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">4</span>
            <span>Ticketing & Payments</span>
          </a>
          <a href="#conduct" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">5</span>
            <span>Prohibited Conduct</span>
          </a>
          <a href="#liability" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">6</span>
            <span>Limitation of Liability</span>
          </a>
          <a href="#governing" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-gray-700 hover:text-primary hover:bg-bg-base/70 transition-all">
            <span class="w-6 h-6 rounded-lg bg-primary/10 text-primary flex items-center justify-center text-xs font-bold">7</span>
            <span>Governing Law & Contact</span>
          </a>
        </nav>
      </div>

      <!-- Legal Support Box -->
      <div class="bg-primary/5 rounded-3xl p-6 border border-primary/20 space-y-3">
        <h4 class="text-sm font-bold text-gray-900 flex items-center gap-2">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
          <span>Need Legal Assistance?</span>
        </h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          For legal inquiries, copyright claims, or terms clarification, please reach out to our legal department.
        </p>
        <a href="mailto:legal@eventhub.com" class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:underline">
          <span>Contact Legal Team &rarr;</span>
        </a>
      </div>
    </div>

    <!-- RIGHT COLUMN: TERMS OF SERVICE SECTIONS (8 COLS ON LG) -->
    <div class="lg:col-span-8 space-y-8">
      <div class="bg-white rounded-3xl p-6 sm:p-10 border border-accent/40 shadow-lg shadow-gray-200/40 space-y-10 text-gray-700 leading-relaxed">

        <!-- SECTION 1: ACCEPTANCE OF TERMS -->
        <section id="acceptance" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              1
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Acceptance of Terms
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            By creating an account, browsing events, or completing ticket orders on EventHub, you affirm that you are at least 18 years old (or have parent/guardian consent) and agree to comply with all terms and conditions set forth in this document.
          </p>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 2: ACCOUNT REGISTRATION & USER ROLES -->
        <section id="accounts" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              2
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Account Registration & User Roles
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            EventHub provides dual account roles tailored to your usage:
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="bg-bg-base/40 rounded-2xl p-4 border border-gray-200/60 space-y-2">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-primary/10 text-primary border border-primary/20">Attendee Role</span>
              <h4 class="text-sm font-bold text-gray-900">Standard Users</h4>
              <p class="text-xs text-gray-500 leading-relaxed">
                Can browse events, filter listings by category/city, purchase e-tickets, and manage order history.
              </p>
            </div>

            <div class="bg-bg-base/40 rounded-2xl p-4 border border-gray-200/60 space-y-2">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200">Creator Role</span>
              <h4 class="text-sm font-bold text-gray-900">Event Creators</h4>
              <p class="text-xs text-gray-500 leading-relaxed">
                Can publish new event listings, set ticket prices & quantities, manage event details, and track attendee check-ins.
              </p>
            </div>
          </div>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 3: EVENT CREATION & ORGANIZER OBLIGATIONS -->
        <section id="organizers" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              3
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Event Creation & Organizer Obligations
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            Event creators are solely responsible for ensuring that published events comply with local laws and regulations. Organizers warrant that:
          </p>

          <ul class="space-y-3 text-sm text-gray-600 font-normal">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Accurate Information:</strong> Event venue, date, time, and ticket capacity must be truthful and updated promptly.</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Proper Authorization:</strong> Creators must hold valid permits and intellectual property rights for media used in listings.</span>
            </li>
          </ul>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 4: TICKETING & PAYMENTS -->
        <section id="tickets" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              4
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Ticketing & Order Fulfillment
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            All ticket purchases are final once confirmed. Tickets are issued as digital e-Tickets and accessible via your user account.
          </p>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 5: PROHIBITED CONDUCT -->
        <section id="conduct" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              5
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Prohibited Conduct & Community Rules
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            Users are strictly prohibited from creating fraudulent event listings, scalping tickets above authorized limits, attempting unauthorized database access, or posting illegal content. Violations will result in immediate account suspension.
          </p>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 6: LIMITATION OF LIABILITY -->
        <section id="liability" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              6
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Limitation of Liability
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            EventHub provides a platform connecting attendees and event organizers. EventHub is not liable for event cancellations, venue safety incidents, or third-party performance issues beyond our reasonable control.
          </p>
        </section>

        <hr class="border-gray-100" />

        <!-- SECTION 7: GOVERNING LAW & CONTACT -->
        <section id="governing" class="space-y-4 scroll-mt-28">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-primary/10 text-primary font-black text-base flex items-center justify-center border border-primary/20 shrink-0">
              7
            </div>
            <h2 class="text-xl sm:text-2xl font-extrabold text-gray-900 tracking-tight">
              Governing Law & Contact Us
            </h2>
          </div>

          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            These Terms of Service are governed by and construed in accordance with the laws of the Republic of Indonesia.
          </p>

          <div class="bg-primary/5 rounded-2xl p-5 border border-primary/20 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h4 class="text-base font-bold text-gray-900">EventHub Legal Department</h4>
              <p class="text-xs text-gray-500 mt-0.5">Yogyakarta, Indonesia</p>
            </div>
            <a href="mailto:legal@eventhub.com" class="inline-flex items-center gap-2 bg-primary hover:bg-secondary text-white font-bold text-xs py-3 px-5 rounded-xl shadow-md shadow-primary/20 transition-all self-start sm:self-auto">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>support@eventhub.com</span>
            </a>
          </div>
        </section>

      </div>
    </div>

  </div>

</main>
<!-- ==================== END MAIN CONTENT ==================== -->

<%- include('../partials/footer'); %>